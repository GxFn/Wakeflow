{
  "name": "claude-code-wakeflow",
  "version": "0.8.0",
  "type": "module",
  "description": "Unattended control loops for Claude Code workspaces, aligned with Wakeflow's Codex edition.",
  "license": "MIT",
  "homepage": "https://github.com/GxFn/Wakeflow#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/GxFn/Wakeflow.git"
  },
  "keywords": [
    "agent-workflow",
    "unattended",
    "control-plane",
    "multi-window",
    "local-first",
    "evidence-review"
  ],
  "bin": {
    "wakeflow-mcp": "./mcp/server.cjs"
  },
  "files": [
