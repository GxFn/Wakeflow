{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:audit:local-preservation:v1",
  "title": "Wakeflow Local Audit Preservation",
  "$comment": "Create-only machine-local audit hold metadata. The payload tree is isolated beside this manifest and is never a normal runtime, compatibility, or recovery input.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "preservationId",
    "producer",
    "createdAt",
    "source",
    "reason",
    "payload",
    "retention",
    "links"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "WakeflowLocalPreservation" },
    "schemaVersion": { "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "preservationId": { "$ref": "#/$defs/preservationId" },
    "producer": {
      "enum": [
        "archive-demand",
        "migration",
        "sanitize-archive",
        "storage-preserve"
      ]
    },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "source": { "$ref": "#/$defs/source" },
    "reason": { "$ref": "#/$defs/reason" },
    "payload": { "$ref": "#/$defs/payload" },
    "retention": { "$ref": "#/$defs/retention" },
    "links": { "$ref": "#/$defs/links" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "producer": { "const": "migration" } },
        "required": ["producer"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": { "storageClass": { "const": "migration-preimage" } }
          },
          "links": {
            "properties": { "migrationId": { "$ref": "#/$defs/token" } }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "producer": { "const": "storage-preserve" } },
        "required": ["producer"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "storageClass": { "enum": ["legacy", "unknown", "corrupt"] }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "producer": { "enum": ["archive-demand", "sanitize-archive"] }
        },
        "required": ["producer"]
      },
      "then": {
        "properties": {
          "source": {
            "properties": { "storageClass": { "const": "archive-original" } }
          },
          "links": {
            "properties": {
              "demandId": { "$ref": "#/$defs/demandId" },
              "archiveManifestDigest": { "$ref": "#/$defs/digest" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "preservationId": {
      "type": "string",
      "pattern": "^preservation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "source": {
      "type": "object",
      "required": ["relativePath", "storageClass", "type"],
      "additionalProperties": false,
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[\\u0000-\\u001F\\u007F-\\u009F])[^/].*[^/]$|^[^/]$"
        },
        "storageClass": {
          "enum": [
            "archive-original",
            "corrupt",
            "legacy",
            "migration-preimage",
            "unknown"
          ]
        },
        "type": { "enum": ["directory", "file"] }
      }
    },
    "reason": {
      "type": "object",
      "required": ["code", "note"],
      "additionalProperties": false,
      "properties": {
        "code": { "$ref": "#/$defs/token" },
        "note": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
            }
          ]
        }
      }
    },
    "treeDigest": {
      "type": "object",
      "required": ["algorithm", "value", "entries"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "$ref": "#/$defs/digest" },
        "entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20000
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["treeDigest", "bytes"],
      "additionalProperties": false,
      "properties": {
        "treeDigest": { "$ref": "#/$defs/treeDigest" },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "retention": {
      "type": "object",
      "required": ["class", "reviewAfter", "requiresExplicitRelease"],
      "additionalProperties": false,
      "properties": {
        "class": { "const": "reviewable-local-audit" },
        "reviewAfter": { "$ref": "#/$defs/timestamp" },
        "requiresExplicitRelease": { "const": true }
      }
    },
    "links": {
      "type": "object",
      "required": ["demandId", "archiveManifestDigest", "migrationId"],
      "additionalProperties": false,
      "properties": {
        "demandId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/demandId" }
          ]
        },
        "archiveManifestDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/digest" }
          ]
        },
        "migrationId": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/token" }
          ]
        }
      }
    }
  }
}
