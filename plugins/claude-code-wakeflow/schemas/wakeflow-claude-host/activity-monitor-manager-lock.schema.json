{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:claude-activity-monitor-manager-lock:v1",
  "title": "Wakeflow Claude Activity Monitor Manager Lock",
  "description": "Short-lived Claude-only manager mutex for one opaque tmux server context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "serverContextId",
    "serverContextDigest",
    "lockId",
    "workspaceOperationId",
    "owner",
    "acquiredAt",
    "lockDigest"
  ],
  "properties": {
    "kind": { "const": "WakeflowClaudeActivityMonitorManagerLock" },
    "schemaVersion": { "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "const": "claude-code" },
    "serverContextId": { "$ref": "#/$defs/serverContextId" },
    "serverContextDigest": { "$ref": "#/$defs/digest" },
    "lockId": {
      "type": "string",
      "pattern": "^claude-activity-lock_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspaceOperationId": {
      "type": "string",
      "pattern": "^workspace-mutation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "owner": { "$ref": "#/$defs/processIdentity" },
    "acquiredAt": { "$ref": "#/$defs/timestamp" },
    "lockDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "serverContextId": {
      "type": "string",
      "pattern": "^claude-server-context_[0-9a-f]{64}$"
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "pid", "startIdentity"],
      "properties": {
        "platform": { "enum": ["darwin", "linux"] },
        "pid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "startIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
