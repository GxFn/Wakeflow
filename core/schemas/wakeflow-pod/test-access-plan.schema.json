{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:pod:test-access-plan:v1",
  "title": "Wakeflow Pod Test Access Plan",
  "$comment": "Create-once private-root probe plan. Runtime validation recomputes bindingSetDigest, canonical target order, exact current identity/creation tuples, and retry lineage.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "podId",
    "demandId",
    "probeId",
    "attempt",
    "probeType",
    "bindingSetDigest",
    "observer",
    "targets",
    "createdAt"
  ],
  "properties": {
    "kind": { "type": "string", "const": "WakeflowPodTestAccessPlan" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "podId": { "$ref": "#/$defs/podId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "probeId": { "$ref": "#/$defs/probeId" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 32 },
    "previousProbeId": { "$ref": "#/$defs/probeId" },
    "probeType": { "type": "string", "const": "direct-multi-root" },
    "bindingSetDigest": { "$ref": "#/$defs/digest" },
    "observer": { "$ref": "#/$defs/observer" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "attempt": { "minimum": 2 } }, "required": ["attempt"] },
      "then": { "required": ["previousProbeId"] },
      "else": { "not": { "required": ["previousProbeId"] } }
    }
  ],
  "$defs": {
    "programId": { "type": "string", "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hostId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "podId": { "type": "string", "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "demandId": { "type": "string", "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "windowId": { "type": "string", "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "repositoryId": { "type": "string", "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "probeId": { "type": "string", "pattern": "^pod-test-probe_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "bindingId": { "type": "string", "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "minLength": 1, "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$" },
    "observer": {
      "type": "object",
      "required": ["windowId", "bindingId", "identityBindingDigest", "creationReceiptDigest"],
      "properties": {
        "windowId": { "$ref": "#/$defs/windowId" },
        "bindingId": { "$ref": "#/$defs/bindingId" },
        "identityBindingDigest": { "$ref": "#/$defs/digest" },
        "creationReceiptDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "windowId",
        "repositoryId",
        "bindingId",
        "identityBindingDigest",
        "creationReceiptDigest",
        "actualRoot",
        "expectedRootDigest",
        "expectedGitTopLevelDigest",
        "expectedGitCommonDirDigest"
      ],
      "properties": {
        "windowId": { "$ref": "#/$defs/windowId" },
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "bindingId": { "$ref": "#/$defs/bindingId" },
        "identityBindingDigest": { "$ref": "#/$defs/digest" },
        "creationReceiptDigest": { "$ref": "#/$defs/digest" },
        "actualRoot": { "$ref": "#/$defs/absolutePath" },
        "expectedRootDigest": { "$ref": "#/$defs/digest" },
        "expectedGitTopLevelDigest": { "$ref": "#/$defs/digest" },
        "expectedGitCommonDirDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
