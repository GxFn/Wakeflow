{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:pod:resume-observation:v1",
  "title": "Wakeflow Pod Resume Observation",
  "$comment": "Append-only redacted resume observation. Raw handles and repeated cwd authority remain outside this record.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "podId",
    "demandId",
    "windowId",
    "observationId",
    "bindingId",
    "creationReceiptDigest",
    "identityBindingDigest",
    "liveness",
    "cwdMatch",
    "observedAt"
  ],
  "properties": {
    "kind": { "type": "string", "const": "WakeflowPodResumeObservation" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "podId": { "$ref": "#/$defs/podId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "windowId": { "$ref": "#/$defs/windowId" },
    "observationId": { "$ref": "#/$defs/observationId" },
    "bindingId": { "$ref": "#/$defs/bindingId" },
    "creationReceiptDigest": { "$ref": "#/$defs/digest" },
    "identityBindingDigest": { "$ref": "#/$defs/digest" },
    "liveness": { "type": "string", "enum": ["ambiguous", "live", "unavailable"] },
    "cwdMatch": { "type": "boolean" },
    "currentHead": { "$ref": "#/$defs/gitObject" },
    "branch": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] },
    "detached": { "type": "boolean" },
    "dirty": { "type": "boolean" },
    "observedAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "liveness": { "not": { "const": "live" } } }, "required": ["liveness"] },
      "then": { "not": { "anyOf": [
        { "required": ["currentHead"] },
        { "required": ["branch"] },
        { "required": ["detached"] },
        { "required": ["dirty"] }
      ] } }
    }
  ],
  "$defs": {
    "programId": { "type": "string", "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hostId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "podId": { "type": "string", "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "demandId": { "type": "string", "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "windowId": { "type": "string", "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "observationId": { "type": "string", "pattern": "^pod-resume-observation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "bindingId": { "type": "string", "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$" }
  }
}
