{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:demand-artifact:pod-design-handoff:v1",
  "title": "Wakeflow Pod Design Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "podDesignHandoffId",
    "programId",
    "demandId",
    "demandRef",
    "demandDigest",
    "podId",
    "designRequest",
    "demandAuthority",
    "preservesOriginalGoal",
    "requirementRefs",
    "designIntent",
    "landingPlan",
    "testDecision",
    "nonGoals",
    "risks",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "wakeflow-pod-design-handoff" },
    "podDesignHandoffId": { "$ref": "#/$defs/podDesignHandoffId" },
    "programId": { "$ref": "#/$defs/programId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "demandRef": { "const": "demand.json" },
    "demandDigest": { "$ref": "#/$defs/digest" },
    "podId": { "$ref": "#/$defs/podId" },
    "designRequest": { "$ref": "#/$defs/designRequestTuple" },
    "demandAuthority": { "$ref": "#/$defs/demandAuthorityTuple" },
    "preservesOriginalGoal": { "const": true },
    "requirementRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementRef" }
    },
    "designIntent": { "$ref": "#/$defs/trimmedText" },
    "landingPlan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/landingEntry" }
    },
    "testDecision": { "$ref": "#/$defs/testDecision" },
    "nonGoals": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "risks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "podId": {
      "type": "string",
      "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "podDesignRequestId": {
      "type": "string",
      "pattern": "^pod-design-request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "podDesignHandoffId": {
      "type": "string",
      "pattern": "^pod-design-handoff_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "portableRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\s)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*/$)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "requirementRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "ref", "digest"],
      "properties": {
        "role": {
          "enum": ["completion", "constraint", "design", "evidence", "goal", "validation"]
        },
        "ref": { "$ref": "#/$defs/portableRef" },
        "digest": { "$ref": "#/$defs/digest" },
        "anchor": { "$ref": "#/$defs/opaqueToken" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "evidence" } },
            "required": ["role"]
          },
          "else": { "required": ["anchor"] }
        }
      ]
    },
    "designRequestTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podDesignRequestId", "ref", "digest"],
      "properties": {
        "podDesignRequestId": { "$ref": "#/$defs/podDesignRequestId" },
        "ref": {
          "type": "string",
          "pattern": "^pod/design-requests/pod-design-request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
        },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "demandAuthorityTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "const": "demand-authority.json" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "landingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "responsibilityWindowId", "workScope"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "responsibilityWindowId": { "$ref": "#/$defs/windowId" },
        "workScope": { "$ref": "#/$defs/trimmedText" }
      }
    },
    "testDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "summary"],
      "properties": {
        "mode": { "enum": ["controller-only", "not-applicable", "real-environment"] },
        "summary": { "$ref": "#/$defs/trimmedText" },
        "environmentSpecRef": { "$ref": "#/$defs/portableRef" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "real-environment" } },
            "required": ["mode"]
          },
          "then": { "required": ["environmentSpecRef"] },
          "else": { "not": { "required": ["environmentSpecRef"] } }
        }
      ]
    }
  }
}
