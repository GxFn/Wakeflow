{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wakeflow/task-package.schema.json",
  "title": "Task Package",
  "type": "object",
  "required": ["schemaVersion", "taskPackageId", "demandKey", "summary", "status", "targetTasks"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "taskPackageId": { "type": "string", "minLength": 1 },
    "demandKey": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "status": { "type": "string" },
    "targetTasks": { "type": "array", "items": { "type": "object" } },
    "createdAt": { "type": "string" },
    "sourceRef": { "type": ["string", "null"] },
    "contextVersion": { "type": "integer", "const": 1 },
    "workType": { "type": "string", "enum": ["implementation", "research", "documentation", "test"] },
    "objective": { "type": "string", "minLength": 1 },
    "contextSummary": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirementRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "role"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["goal", "completion", "constraint", "validation", "design", "evidence"] },
          "label": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["inScope", "outOfScope", "forbidden"],
      "properties": {
        "inScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outOfScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "completionExpectations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependsOnTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commitExpectation": { "type": "string", "enum": ["commit", "leave-uncommitted"] },
    "designIntent": { "type": ["string", "null"] },
    "acceptanceAnchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim", "probe", "expected"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "claim": { "type": "string", "minLength": 1 },
          "probe": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "evidenceContract": { "type": "object" },
    "continuation": {
      "type": "object",
      "required": ["continuationId", "type", "reason", "evidenceRefs", "priorCompletionEventId", "priorCompletionRevision", "createdAt"],
      "properties": {
        "continuationId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["verified-bug", "requirement-supplement", "optimization"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "priorCompletionEventId": { "type": "string", "minLength": 1 },
        "priorCompletionRevision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "testExecution": {
      "type": "object",
      "required": ["testCardId", "testCardRef", "strategySource", "lineageStep", "dispatchAttempt", "mode", "requirementGoal", "approvedPlan", "allowedSkills", "setupPolicy", "maxAttempts", "restartConditions", "changeControl"],
      "properties": {
        "testCardId": { "type": "string", "minLength": 1 },
        "testCardRef": { "type": "string", "minLength": 1 },
        "strategySource": { "type": "string", "minLength": 1 },
        "lineageStep": { "type": "integer", "minimum": 1 },
        "dispatchAttempt": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["initial", "resume", "restart"] },
        "requirementGoal": { "type": "string", "minLength": 1 },
        "approvedPlan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "allowedSkills": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "setupPolicy": { "enum": ["reuse-existing", "fresh-once", "fresh-per-attempt"] },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "restartConditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "changeControl": { "type": "object" }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["contextVersion"] },
      "then": {
        "required": [
          "workType",
          "objective",
          "contextSummary",
          "requirementRefs",
          "boundaries",
          "completionExpectations",
          "dependsOnTaskIds",
          "commitExpectation"
        ]
      }
    },
    {
      "if": {
        "properties": { "workType": { "const": "implementation" } },
        "required": ["workType"]
      },
      "then": { "required": ["acceptanceAnchors"] }
    }
  ],
  "additionalProperties": true
}
