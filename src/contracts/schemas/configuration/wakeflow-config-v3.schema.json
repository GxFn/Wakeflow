    "runtimeResidue": {
      "description": "Named collection of one or more typed process-command matchers used only by validation.",
      "examples": [
        {
          "label": "product runtime",
          "matchers": [
            {
              "kind": "substring",
              "value": "product-dev-server"
            }
          ]
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "matchers"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing label used when reporting matched runtime residue.",
          "examples": [
            "product runtime"
          ]
        },
        "matchers": {
          "type": "array",
          "minItems": 1,
          "description": "One or more typed substring/regex matchers; each regex is compiled during strict loading.",
          "examples": [
            [
              {
                "kind": "substring",
                "value": "product-dev-server"
              }
            ]
          ],
          "items": {
            "$ref": "#/$defs/runtimeMatcher"
          }
        }
      }
    },
    "runtimeMatcher": {
      "oneOf": [
        {
          "$ref": "#/$defs/substringRuntimeMatcher"
        },
        {
          "$ref": "#/$defs/regexRuntimeMatcher"
        }
      ],
      "description": "Discriminated runtime-residue matcher. Substring and regex values use separate lexical contracts.",
      "examples": [
        {
          "kind": "substring",
          "value": "product-dev-server"
        },
        {
          "kind": "regex",
          "value": "node\\s+server\\.mjs"
        }
      ]
    },
    "substringRuntimeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "substring",
          "description": "Selects literal substring matching without regular-expression interpretation.",
          "examples": [
            "substring"
          ]
        },
        "value": {
          "$ref": "#/$defs/trimmedNonEmptyString",
          "description": "Literal non-empty process-command fragment.",
          "examples": [
            "product-dev-server"
          ]
        }
      },
      "description": "Strict literal substring matcher for runtime-residue validation.",
      "examples": [
        {
          "kind": "substring",
          "value": "product-dev-server"
        }
      ]
    },
    "regexRuntimeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "regex",
          "description": "Selects a validated ECMAScript regular-expression source.",
          "examples": [
            "regex"
          ]
        },
        "value": {
          "$ref": "#/$defs/regexPattern",
          "description": "Validated Unicode ECMAScript regular-expression source.",
          "examples": [
            "node\\s+server\\.mjs"
          ]
        }
      },
      "description": "Strict regular-expression matcher for runtime-residue validation.",
      "examples": [
        {
          "kind": "regex",
          "value": "node\\s+server\\.mjs"
        }
      ]
    },
