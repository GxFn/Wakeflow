        "disposition",
        "readbackStatus",
        "claimHandling",
        "observedAt"
      ],
      "properties": {
        "observationDigest": {
          "$ref": "urn:wakeflow:foundation:crypto:sha256-digest:v1"
        },
        "disposition": {
          "enum": ["accepted", "indeterminate", "rejected-before-effect"]
        },
        "readbackStatus": {
          "enum": ["confirmed", "pending", "unavailable"]
        },
        "claimHandling": {
          "enum": ["retain", "release-authorized"]
        },
        "observedAt": {
          "$ref": "urn:wakeflow:foundation:time:utc-instant:v1"
        }
      }
    },
