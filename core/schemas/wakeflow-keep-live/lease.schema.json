{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:keep-live:lease:v1",
  "title": "Wakeflow Keep-Live Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "hostId",
    "demandId",
    "automationRunId",
    "acquiredAt",
    "lastConfirmedAt",
    "leaseDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "wakeflow-keep-live-lease" },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "automationRunId": { "$ref": "#/$defs/dispatchGroupId" },
    "acquiredAt": { "$ref": "#/$defs/timestamp" },
    "lastConfirmedAt": { "$ref": "#/$defs/timestamp" },
    "leaseDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "dispatchGroupId": {
      "type": "string",
      "pattern": "^dispatch-group_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hostId": {
      "type": "string",
      "enum": ["codex", "claude-code"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
