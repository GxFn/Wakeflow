{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GxFn/Wakeflow/main/core/schemas/wakeflow-config.schema.json",
  "title": "Wakeflow workspace configuration v2",
  "type": "object",
  "required": ["schemaVersion", "workspace", "roles", "storage", "repositories", "hosts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "workspace": {
      "type": "object",
      "required": ["name", "language", "runtimeMode", "root", "wakeflowRepoDir"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "language": { "enum": ["auto", "zh", "en"] },
        "runtimeMode": { "enum": ["plugin", "repository"] },
        "root": { "type": "string", "minLength": 1 },
        "wakeflowRepoDir": { "type": "string" }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "required": ["controller", "design", "test"],
      "properties": {
        "controller": { "type": "string", "minLength": 1 },
        "design": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "realProject": { "type": "string" },
        "base": { "type": "string" }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["activeRoot", "localRoot", "ledgerRoot"],
      "properties": {
        "activeRoot": { "type": "string", "minLength": 1 },
        "localRoot": { "const": ".wakeflow-local" },
        "ledgerRoot": { "type": "string", "minLength": 1 },
        "windowLedgerRoot": { "type": "string", "minLength": 1 },
        "windowLedgerDirs": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "paths": {
          "type": "object",
          "properties": {
            "workspaceDocsDir": { "type": "string", "minLength": 1 },
            "workspaceCurrentDir": { "type": "string", "minLength": 1 },
            "workspaceArchiveDir": { "type": "string", "minLength": 1 },
            "workspaceIndexPath": { "type": "string", "minLength": 1 },
            "workspaceCurrentIndexPath": { "type": "string", "minLength": 1 },
            "workspaceCurrentStatusPath": { "type": "string", "minLength": 1 },
            "workspaceRecordMapPath": { "type": "string", "minLength": 1 },
            "globalTodoPath": { "type": "string", "minLength": 1 },
            "requirementDesignsDir": { "type": "string", "minLength": 1 },
            "goalStageConfirmationDir": { "type": "string", "minLength": 1 },
            "testExchangePath": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "allowMissingRepos": { "type": "boolean" },
        "preservedRetentionDays": { "type": "number", "exclusiveMinimum": 0 },
        "disallowedTrackedPaths": { "type": "array", "items": { "type": "string" } },
        "allowedRepositoryResiduePaths": { "type": "array", "items": { "type": "string" } },
        "runtimeProcessMatchers": { "type": "array", "items": { "type": "string" } },
        "runtimeProcessLabel": { "type": "string" }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["windowName", "path"],
        "properties": {
          "windowName": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "role": { "type": "string" },
          "mode": { "enum": ["internal", "external"] },
          "managedAgents": { "type": "boolean" },
          "stream": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "hosts": { "type": "object" },
    "derived": {
      "type": "object",
      "description": "Legacy local stream overlay metadata; durable setup never writes it."
    }
  },
  "additionalProperties": false
}
