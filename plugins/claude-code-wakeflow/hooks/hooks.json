{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/observe.mjs",
              "--wakeflow-hook-observer-v1",
              "--host",
              "claude-code"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/observe.mjs",
              "--wakeflow-hook-observer-v1",
              "--host",
              "claude-code"
            ],
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/observe.mjs",
              "--wakeflow-hook-observer-v1",
              "--host",
              "claude-code"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/observe.mjs",
              "--wakeflow-hook-observer-v1",
              "--host",
              "claude-code"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
