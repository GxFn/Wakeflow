{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:pod:creation-receipt:v1",
  "title": "Wakeflow Pod Creation Receipt",
  "$comment": "Create-once canonical core verification of finalized materialization, current identity binding, and host-local resource facts. It never contains a raw host handle.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "podId",
    "demandId",
    "windowId",
    "launchOperationId",
    "bindingId",
    "launchIntentDigest",
    "materializationFinalEventDigest",
    "identityBindingDigest",
    "resource",
    "verifiedAt"
  ],
  "properties": {
    "kind": { "type": "string", "const": "WakeflowPodCreationReceipt" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "podId": { "$ref": "#/$defs/podId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "windowId": { "$ref": "#/$defs/windowId" },
    "launchOperationId": { "$ref": "#/$defs/launchOperationId" },
    "bindingId": { "$ref": "#/$defs/bindingId" },
    "launchIntentDigest": { "$ref": "#/$defs/digest" },
    "materializationFinalEventDigest": { "$ref": "#/$defs/digest" },
    "identityBindingDigest": { "$ref": "#/$defs/digest" },
    "resource": {
      "oneOf": [
        { "$ref": "#/$defs/programRoot" },
        { "$ref": "#/$defs/gitWorktree" }
      ]
    },
    "hostCreatedAt": { "$ref": "#/$defs/timestamp" },
    "verifiedAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "$defs": {
    "programId": { "type": "string", "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hostId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "podId": { "type": "string", "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "demandId": { "type": "string", "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "windowId": { "type": "string", "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "launchOperationId": { "type": "string", "pattern": "^pod-launch_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "bindingId": { "type": "string", "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "absolutePath": { "type": "string", "minLength": 1, "pattern": "^(?:/|[A-Za-z]:[\\\\/])" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$" },
    "programRoot": {
      "type": "object",
      "required": ["kind", "actualCwd"],
      "properties": {
        "kind": { "type": "string", "const": "program-root" },
        "actualCwd": { "$ref": "#/$defs/absolutePath" }
      },
      "additionalProperties": false
    },
    "gitWorktree": {
      "type": "object",
      "required": ["kind", "actualCwd", "gitTopLevel", "gitCommonDir", "head", "branch", "detached", "mainCheckout"],
      "properties": {
        "kind": { "type": "string", "const": "git-worktree" },
        "actualCwd": { "$ref": "#/$defs/absolutePath" },
        "gitTopLevel": { "$ref": "#/$defs/absolutePath" },
        "gitCommonDir": { "$ref": "#/$defs/absolutePath" },
        "head": { "$ref": "#/$defs/gitObject" },
        "branch": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 512 }, { "type": "null" }] },
        "detached": { "type": "boolean" },
        "mainCheckout": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    }
  }
}
