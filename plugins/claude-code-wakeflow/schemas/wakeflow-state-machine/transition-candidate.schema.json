{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wakeflow/transition-candidate.schema.json",
  "title": "Transition Candidate",
  "type": "object",
  "required": ["schemaVersion", "candidateId", "demandKey", "fromRevision", "candidateState", "reason", "resultSnapshots"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "demandKey": { "type": "string", "minLength": 1 },
    "fromRevision": { "type": "integer", "minimum": 1 },
    "candidateState": { "type": "string" },
    "reason": { "type": "string" },
    "reviewStatus": { "type": "string" },
    "readyResultIds": { "type": "array", "items": { "type": "string" } },
    "blockedResultIds": { "type": "array", "items": { "type": "string" } },
    "missingResultIds": { "type": "array", "items": { "type": "string" } },
    "reviewScope": { "type": "string" },
    "targetTaskIds": { "type": "array", "items": { "type": "string" } },
    "excludedTargetTaskIds": { "type": "array", "items": { "type": "string" } },
    "resultSnapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["targetTaskId", "resultId", "resultRevision", "dispatchGroup", "status"],
        "properties": {
          "targetTaskId": { "type": "string", "minLength": 1 },
          "resultId": { "type": "string", "minLength": 1 },
          "resultRevision": { "type": "integer", "minimum": 1 },
          "dispatchGroup": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["completed", "blocked", "needs-review"] }
        },
        "additionalProperties": false
      }
    },
    "allowedDecisions": { "type": "array", "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "wakeflowTrace": { "type": "object" },
    "forbiddenConclusions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
