          "enum": [
            "accept",
            "request-another-attempt",
            "escalate-product-defect",
            "blocked"
          ]
        },
        "controllerWindowId": {
          "$ref": "#/$defs/windowId"
        },
        "decidedAt": {
          "$ref": "urn:wakeflow:foundation:time:utc-instant:v1"
        }
      }
