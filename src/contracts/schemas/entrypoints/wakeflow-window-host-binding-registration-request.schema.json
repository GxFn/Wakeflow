{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:entrypoints:window-host-binding-registration-request:v1",
  "x-wakeflow-runtime-export": "WAKEFLOW_WINDOW_HOST_BINDING_REGISTRATION_REQUEST_SCHEMA",
  "title": "WakeflowWindowHostBindingRegistrationRequestV1",
  "description": "One execution-endpoint operation on a logical window: inspect, register, replace (CAS on the old binding), relocate (new tmux pane, CAS; tmux transport only), decommission (closure evidence) or release-claim (liveness evidence).",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/inspectRequest"
    },
    {
      "$ref": "#/$defs/registerRequest"
    },
    {
      "$ref": "#/$defs/replaceRequest"
    },
    {
      "$ref": "#/$defs/relocateRequest"
    },
    {
      "$ref": "#/$defs/decommissionRequest"
    },
    {
      "$ref": "#/$defs/releaseClaimRequest"
    }
  ],
  "$defs": {
    "root": {
      "type": "string",
      "description": "Absolute path of the existing workspace root. Physical root validation remains owned by RootedDirectory."
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^window_binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utcInstant": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "hostHandle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "tmuxCoordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["socketName", "sessionName", "windowId", "paneId"],
      "properties": {
        "socketName": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "windowId": {
          "type": "string",
          "pattern": "^@[0-9]{1,9}$"
        },
        "paneId": {
          "type": "string",
          "pattern": "^%[0-9]{1,9}$"
        }
      }
    },
    "desktopSessionLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^local_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      },
      "description": "The desktop app's id of the session running this window (`local_` + the session UUID), reported verbatim as the desktop helper printed it; never derived from the handle."
    },
    "creationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "launchIntentDigest", "observedAt"],
      "properties": {
        "handle": {
          "$ref": "#/$defs/hostHandle"
        },
        "launchIntentDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "observedAt": {
          "$ref": "#/$defs/utcInstant"
        },
        "tmux": {
          "$ref": "#/$defs/tmuxCoordinates"
        },
        "desktop": {
          "$ref": "#/$defs/desktopSessionLocator"
        },
        "worktree": {
          "$ref": "#/$defs/worktreeObservation"
        },
        "hostVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        }
      },
      "description": "What the Agent observed after executing one launch intent: the opaque host handle, on Claude Code the transport's locator (tmux coordinates or the desktop session id, never both), and for the product window of a worktree pod the git worktree facts of that session."
    },
    "tmuxPaneObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "socketName",
        "sessionName",
        "windowId",
        "paneId",
        "paneWindowId",
        "paneDead",
        "currentCommand",
        "options"
      ],
      "properties": {
        "socketName": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          ]
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "windowId": {
          "type": "string",
          "pattern": "^@[0-9]{1,9}$"
        },
        "paneId": {
          "type": "string",
          "pattern": "^%[0-9]{1,9}$"
        },
        "paneWindowId": {
          "type": "string",
          "pattern": "^@[0-9]{1,9}$"
        },
        "paneDead": {
          "type": "boolean"
        },
        "currentCommand": {
          "type": "string",
          "maxLength": 256
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["programId", "hostId", "windowId", "bindingId", "locatorId"],
          "properties": {
            "programId": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 256
                }
              ]
            },
            "hostId": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 64
                }
              ]
            },
            "windowId": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 256
                }
              ]
            },
            "bindingId": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 256
                }
              ]
            },
            "locatorId": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "maxLength": 256
                }
              ]
            }
          }
        }
      },
      "description": "One row of `tmux list-panes -a` with the five Wakeflow window options the Agent read back; Wakeflow classifies it, the Agent never judges liveness."
    },
    "desktopSessionObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "status"],
      "properties": {
        "sessionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "desktopSessionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^local_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          ],
          "description": "The row's `local_` id verbatim."
        },
        "status": {
          "enum": ["busy", "idle"]
        },
        "archived": {
          "type": "boolean",
          "description": "The row's `isArchived`."
        },
        "cwd": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1024
            }
          ]
        },
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 256
            }
          ]
        },
        "pid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        }
      },
      "description": "One `list_sessions` row: `sessionId` without the `local_` prefix, `status` busy when `isRunning`. Wakeflow matches the bound session or desktop id; the Agent never judges liveness."
    },
    "livenessObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "panes"],
          "properties": {
            "kind": {
              "const": "tmux-panes"
            },
            "panes": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/tmuxPaneObservation"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sessions"],
          "properties": {
            "kind": {
              "const": "desktop-sessions"
            },
            "sessions": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/desktopSessionObservation"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "status"],
          "properties": {
            "kind": {
              "const": "codex-thread"
            },
            "status": {
              "enum": ["active", "archived", "unknown"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "unobserved"
            }
          }
        }
      ]
    },
    "inspectRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "operation", "windowId"],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "inspect"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        }
      }
    },
    "registerRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "operation", "windowId", "observation"],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "register"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "observation": {
          "$ref": "#/$defs/creationEvidence"
        }
      }
    },
    "replaceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "operation",
        "windowId",
        "observation",
        "expectedBindingId",
        "expectedBindingDigest"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "replace"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "observation": {
          "$ref": "#/$defs/creationEvidence"
        },
        "expectedBindingId": {
          "$ref": "#/$defs/bindingId"
        },
        "expectedBindingDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "relocateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "operation",
        "windowId",
        "observation",
        "expectedBindingId",
        "expectedBindingDigest"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "relocate"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "observation": {
          "$ref": "#/$defs/creationEvidence"
        },
        "expectedBindingId": {
          "$ref": "#/$defs/bindingId"
        },
        "expectedBindingDigest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "decommissionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "operation",
        "windowId",
        "expectedBindingId",
        "expectedBindingDigest",
        "closure"
      ],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "decommission"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "expectedBindingId": {
          "$ref": "#/$defs/bindingId"
        },
        "expectedBindingDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "closure": {
          "oneOf": [
            {
              "$ref": "#/$defs/closureEvidence"
            },
            {
              "$ref": "#/$defs/observationFile"
            }
          ]
        }
      }
    },
    "releaseClaimRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "operation", "windowId", "expectedClaimDigest", "evidence"],
      "properties": {
        "root": {
          "$ref": "#/$defs/root"
        },
        "operation": {
          "const": "release-claim"
        },
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "expectedClaimDigest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["liveness"],
          "properties": {
            "liveness": {
              "oneOf": [
                {
                  "$ref": "#/$defs/livenessObservation"
                },
                {
                  "$ref": "#/$defs/observationFile"
                }
              ]
            }
          }
        }
      }
    },
    "worktreeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["porcelain", "commonDir"],
      "description": "Git facts observed in the assigned checkout (SessionStart cwd, or executionRoot for project-chat hosts); Wakeflow cross-checks the porcelain entry, common dir and linked .git pointers. Paths stay private.",
      "properties": {
        "porcelain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "commonDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "executionRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Absolute assigned worktree directory, required for project chats whose SessionStart cwd is the outer workspace. Omit for session-root hosts."
        }
      }
    },
    "observationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "digest"],
      "description": "The file object a helper printed (observationFile, closureFile), passed in place of the observation: read, digest-checked and admitted as if inline.",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^\\.wakeflow-local/runtime/hosts/[a-z-]+/observations/helper/[0-9A-Za-z][0-9A-Za-z._-]{0,127}\\.json$"
        },
        "digest": {
          "$ref": "#/$defs/sha256Digest"
        }
      }
    },
    "closureEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preClose", "closeResult", "postClose"],
      "properties": {
        "preClose": {
          "$ref": "#/$defs/livenessObservation"
        },
        "closeResult": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {
              "enum": ["closed", "failed", "unknown"]
            }
          }
        },
        "postClose": {
          "$ref": "#/$defs/livenessObservation"
        }
      }
    },
    "creationEvidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/creationObservation"
        },
        {
          "$ref": "#/$defs/observationFile"
        }
      ]
    }
  }
}
