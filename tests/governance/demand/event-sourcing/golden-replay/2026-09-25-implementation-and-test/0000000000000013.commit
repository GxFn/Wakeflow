          "boundaries": {
            "inScope": [
              "在本工作区 AlembicPlugin 检出的仓库根目录，按冻结的测试契约依次执行 ts-1 至 ts-5 的只读命令，不增不减、不改写步骤。",
              "把每一步的原始输出原样保存到 Test 支持面 `fixtures/demand_e70f27e0-ff97-4379-897e-6e0596c9f3fc/<stepId>.txt`，再用 `wakeflow_record_evidence`（kind test-output，preview 后 apply）登记为本 Demand 的托管证据，报告中逐步引用其 locator 与 digest。",
              "逐步给出 expected、observed 与 verdict，不通过的步骤给出 failure 分类、likelyOwner 与建议动作；用 `wakeflow_import_target_result` 导入测试报告。",
              "导入成功后，用 tmux 助手 deliver 把回调许可的 prompt 原样送进 Controller 窗口（从 Test 窗口在助手路径前加上启动时 `--add-dir` 给的工作区根），并如实记下助手打印的 attempt、readback 与 landing。"
            ],
            "outOfScope": [
              "验收标准 6–10（全仓库状态与前几轮四个文件保持原样）：由 Controller 只读核对，不在本测试中。",
              "Alembic、AlembicAgent、AlembicCore、AlembicDashboard 四个仓库，以及 AlembicPlugin 的测试套件、lint、构建与打包。",
              "修复任何不符项：发现不符只记录与分类，由 Controller 决定后续。"
            ],
            "forbidden": [
              "在 AlembicPlugin 检出中创建、修改、删除或移动任何文件或目录（包括 `docs/wakeflow-smoke-round6.md` 与前几轮的四个冒烟文件），或运行 `git add`、`git commit`、stash、checkout、clean、reset 等改变 HEAD、分支、暂存区或工作树的命令。",
              "修改测试契约：增加、跳过或改写步骤，调整期望值，或用 mock、捷径、其他环境代替真实检出。",
              "在 Test 支持面 `fixtures/` 与 `harnesses/` 之外创建或修改文件；在证据或报告中写入秘密、会话句柄、本机绝对路径或无界日志。",
              "使用凭据、网络或外部服务，安装依赖或构建。",
              "做评审决定或其他 Controller 操作；用 tmux 助手 deliver 以外的方式发送回调。"
            ]
          },
          "completionExpectations": [
            "五个步骤都在真实环境中执行并各有一条托管证据（test-output）；报告逐步给出 observed、证据引用（locator 与 digest）与 verdict，全部一致时 verdict 均为 pass、报告 outcome 为 completed；整体结论由 Wakeflow 从各步记录推导，不自行断言。",
            "任一步不一致时，该步 verdict 为 fail（或 blocked、cannot-conclude），并给出 failure 分类、likelyOwner 与建议动作；不修复，不超出尝试预算。",
            "测试前后 AlembicPlugin 检出保持不变：`git status --porcelain` 仍为五行 `??` 条目，HEAD 与分支不变。",
            "导入成功后，回调经 tmux 助手 deliver 送进 Controller 窗口，助手返回的 attempt 为 sent，并在本轮回复中如实写出 attempt、readback 与 landing；之后结束本轮，不轮询、不重发。"
          ],
          "assignment": {
            "windowId": "window_6a9a3c45-045f-4dac-9c7e-f24ae32c191b"
