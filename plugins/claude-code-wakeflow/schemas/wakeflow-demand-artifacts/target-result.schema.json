{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:demand-artifacts:target-result:v1",
  "title": "Wakeflow Candidate Target Result",
  "$comment": "Structural and lexical contract for one immutable candidate TargetResult. Runtime validation additionally enforces same-demand assignment, exact package and transport bindings, canonical nested placement, evidence policy, supersession relations, state eligibility, and create-only storage.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "demandId",
    "demandRef",
    "demandDigest",
    "createdAt",
    "targetResultId",
    "targetTaskId",
    "taskPackage",
    "assignment",
    "observedState",
    "transport",
    "outcome",
    "summary",
    "repositoryChanges",
    "evidenceLocators",
    "verification",
    "risks",
    "craftMapping"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "wakeflow-target-result" },
    "programId": { "$ref": "#/$defs/programId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "demandRef": { "type": "string", "const": "demand.json" },
    "demandDigest": { "$ref": "#/$defs/digest" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "targetResultId": { "$ref": "#/$defs/targetResultId" },
    "targetTaskId": { "$ref": "#/$defs/targetTaskId" },
    "taskPackage": { "$ref": "#/$defs/taskPackageTuple" },
    "assignment": { "$ref": "#/$defs/assignment" },
    "observedState": { "$ref": "#/$defs/observedState" },
    "transport": { "$ref": "#/$defs/transport" },
    "outcome": {
      "type": "string",
      "enum": ["completed", "blocked", "needs-review"]
    },
    "summary": { "$ref": "#/$defs/trimmedText" },
    "repositoryChanges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repositoryChange" }
    },
    "evidenceLocators": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidenceLocator" }
    },
    "verification": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "risks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "craftMapping": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/acceptanceCraftMapping" },
          { "$ref": "#/$defs/testStepCraftMapping" }
        ]
      }
    },
    "supersedes": { "$ref": "#/$defs/targetResultTuple" }
  },
  "additionalProperties": false,
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskPackageId": {
      "type": "string",
      "pattern": "^task-package_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetTaskId": {
      "type": "string",
      "pattern": "^target-task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetResultId": {
      "type": "string",
      "pattern": "^target-result_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "portableRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\s)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\/$)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "taskPackageRef": {
      "type": "string",
      "pattern": "^task-packages/task-package_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "targetResultRef": {
      "type": "string",
      "pattern": "^target-results/target-task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/target-result_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "taskPackageTuple": {
      "type": "object",
      "required": ["taskPackageId", "ref", "digest"],
      "properties": {
        "taskPackageId": { "$ref": "#/$defs/taskPackageId" },
        "ref": { "$ref": "#/$defs/taskPackageRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "targetResultTuple": {
      "type": "object",
      "required": ["targetResultId", "ref", "digest"],
      "properties": {
        "targetResultId": { "$ref": "#/$defs/targetResultId" },
        "ref": { "$ref": "#/$defs/targetResultRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": ["windowId"],
      "properties": {
        "windowId": { "$ref": "#/$defs/windowId" },
        "repositoryId": { "$ref": "#/$defs/repositoryId" }
      },
      "additionalProperties": false
    },
    "observedState": {
      "type": "object",
      "required": ["revision", "eventId", "eventDigest"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "eventId": { "$ref": "#/$defs/opaqueToken" },
        "eventDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "transportMember": {
      "type": "object",
      "required": ["id", "ref", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/opaqueToken" },
        "ref": { "$ref": "#/$defs/portableRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "transport": {
      "type": "object",
      "required": ["group", "envelope"],
      "properties": {
        "group": { "$ref": "#/$defs/transportMember" },
        "envelope": { "$ref": "#/$defs/transportMember" }
      },
      "additionalProperties": false
    },
    "repositoryChange": {
      "type": "object",
      "required": ["repositoryId", "disposition", "commits"],
      "properties": {
        "repositoryId": { "$ref": "#/$defs/repositoryId" },
        "disposition": {
          "type": "string",
          "enum": ["committed", "left-uncommitted", "no-changes"]
        },
        "commits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueToken" }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "disposition": { "const": "committed" } },
            "required": ["disposition"]
          },
          "then": {
            "properties": { "commits": { "minItems": 1 } }
          },
          "else": {
            "properties": { "commits": { "maxItems": 0 } }
          }
        }
      ]
    },
    "exactPortableRef": {
      "type": "object",
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "$ref": "#/$defs/portableRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "evidenceLocator": {
      "type": "object",
      "required": ["kind", "ref", "digest"],
      "properties": {
        "kind": { "$ref": "#/$defs/opaqueToken" },
        "ref": { "$ref": "#/$defs/portableRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "acceptanceCraftMapping": {
      "type": "object",
      "required": ["kind", "anchorId", "evidenceRefs"],
      "properties": {
        "kind": { "type": "string", "const": "acceptance-anchor" },
        "anchorId": { "$ref": "#/$defs/opaqueToken" },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/exactPortableRef" }
        }
      },
      "additionalProperties": false
    },
    "testStepCraftMapping": {
      "type": "object",
      "required": ["kind", "planIndex", "step", "ref"],
      "properties": {
        "kind": { "type": "string", "const": "test-step" },
        "planIndex": { "type": "integer", "minimum": 0 },
        "step": { "$ref": "#/$defs/trimmedText" },
        "ref": { "$ref": "#/$defs/portableRef" }
      },
      "additionalProperties": false
    }
  }
}
