{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:demand-artifacts:review-candidate:v1",
  "title": "Wakeflow Candidate Review Candidate",
  "$comment": "Structural and lexical contract for one immutable reducer proposal. Runtime validation additionally enforces the exact prior state/event tail, canonical ordered scope and result set, result digest equality, set partition relations, candidate freshness, and create-only storage. Controller decisions never mutate this record.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "demandId",
    "demandRef",
    "demandDigest",
    "createdAt",
    "reviewCandidateId",
    "fromState",
    "reviewScope",
    "results",
    "resultSetDigest",
    "readyTargetTaskIds",
    "blockedTargetTaskIds",
    "missingTargetTaskIds",
    "allowedDecisions",
    "structuralGaps"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "wakeflow-review-candidate" },
    "programId": { "$ref": "#/$defs/programId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "demandRef": { "type": "string", "const": "demand.json" },
    "demandDigest": { "$ref": "#/$defs/digest" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "reviewCandidateId": { "$ref": "#/$defs/reviewCandidateId" },
    "fromState": { "$ref": "#/$defs/fromState" },
    "reviewScope": { "$ref": "#/$defs/reviewScope" },
    "results": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resultTuple" }
    },
    "resultSetDigest": { "$ref": "#/$defs/digest" },
    "readyTargetTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/targetTaskId" }
    },
    "blockedTargetTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/targetTaskId" }
    },
    "missingTargetTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/targetTaskId" }
    },
    "allowedDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["accept", "blocked", "redesign", "rework"]
      }
    },
    "structuralGaps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetTaskId": {
      "type": "string",
      "pattern": "^target-task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetResultId": {
      "type": "string",
      "pattern": "^target-result_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reviewCandidateId": {
      "type": "string",
      "pattern": "^review-candidate_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "targetResultRef": {
      "type": "string",
      "pattern": "^target-results/target-task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/target-result_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "fromState": {
      "type": "object",
      "required": ["revision", "stateDigest", "eventId", "eventDigest"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "stateDigest": { "$ref": "#/$defs/digest" },
        "eventId": { "$ref": "#/$defs/opaqueToken" },
        "eventDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "reviewScope": {
      "type": "object",
      "required": ["targetTaskIds", "excludedTargetTaskIds"],
      "properties": {
        "targetTaskIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetTaskId" }
        },
        "excludedTargetTaskIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetTaskId" }
        }
      },
      "additionalProperties": false
    },
    "resultTuple": {
      "type": "object",
      "required": ["targetTaskId", "targetResultId", "ref", "digest", "outcome"],
      "properties": {
        "targetTaskId": { "$ref": "#/$defs/targetTaskId" },
        "targetResultId": { "$ref": "#/$defs/targetResultId" },
        "ref": { "$ref": "#/$defs/targetResultRef" },
        "digest": { "$ref": "#/$defs/digest" },
        "outcome": {
          "type": "string",
          "enum": ["completed", "blocked", "needs-review"]
        }
      },
      "additionalProperties": false
    }
  }
}
