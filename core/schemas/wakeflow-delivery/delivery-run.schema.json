{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:delivery:delivery-run:v1",
  "title": "Wakeflow Direct-Thread Delivery Run",
  "$comment": "Closed append-only fact for one host delivery attempt. Runtime validation additionally enforces canonical refs, the complete self-excluding digest, exact envelope closure, optional record-time target lease closure, and a single non-forking previous-run chain. It does not decide resend permission, target completion, controller acceptance, or current lease/state authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "demandId",
    "runId",
    "deliveryId",
    "envelopeRef",
    "envelopeDigest",
    "hostId",
    "windowId",
    "attemptOrdinal",
    "hostMethod",
    "hostMode",
    "transportStatus",
    "readback",
    "createdAt",
    "runDigest"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactKind": {
      "type": "string",
      "const": "wakeflow-direct-thread-delivery-run"
    },
    "programId": {
      "$ref": "#/$defs/programId"
    },
    "demandId": {
      "$ref": "#/$defs/demandId"
    },
    "runId": {
      "$ref": "#/$defs/runId"
    },
    "deliveryId": {
      "$ref": "#/$defs/deliveryId"
    },
    "envelopeRef": {
      "$ref": "#/$defs/envelopeRef"
    },
    "envelopeDigest": {
      "$ref": "#/$defs/digest"
    },
    "hostId": {
      "type": "string",
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "windowId": {
      "$ref": "#/$defs/windowId"
    },
    "attemptOrdinal": {
      "type": "integer",
      "minimum": 1
    },
    "previousRun": {
      "$ref": "#/$defs/previousRun"
    },
    "hostMethod": {
      "$ref": "#/$defs/hostFactToken"
    },
    "hostMode": {
      "$ref": "#/$defs/hostFactToken"
    },
    "transportStatus": {
      "type": "string",
      "enum": [
        "accepted",
        "ambiguous",
        "rejected-before-send"
      ]
    },
    "readback": {
      "$ref": "#/$defs/readback"
    },
    "observedLease": {
      "$ref": "#/$defs/observedLease"
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "createdAt": {
      "$ref": "#/$defs/strictUtcTimestamp"
    },
    "runDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "attemptOrdinal": {
            "const": 1
          }
        },
        "required": [
          "attemptOrdinal"
        ]
      },
      "then": {
        "not": {
          "required": [
            "previousRun"
          ]
        }
      },
      "else": {
        "required": [
          "previousRun"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transportStatus": {
            "enum": [
              "ambiguous",
              "rejected-before-send"
            ]
          }
        },
        "required": [
          "transportStatus"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "transportStatus": {
            "const": "rejected-before-send"
          }
        },
        "required": [
          "transportStatus"
        ]
      },
      "then": {
        "properties": {
          "readback": {
            "properties": {
              "status": {
                "const": "unavailable"
              },
              "attempts": {
                "const": 0
              },
              "evidence": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^delivery-run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^delivery_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lease_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "envelopeRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/shared/transport/demands/demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/envelopes/delivery_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "runRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/shared/transport/demands/demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/runs/delivery-run_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "leaseRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/shared/coordination/window-leases/window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "hostFactToken": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$",
      "not": {
        "enum": [
          "default",
          "none",
          "unknown",
          "unspecified"
        ]
      }
    },
    "previousRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "ref",
        "digest"
      ],
      "properties": {
        "runId": {
          "$ref": "#/$defs/runId"
        },
        "ref": {
          "$ref": "#/$defs/runRef"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "readbackEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/hostFactToken"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "attempts",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "pending",
            "unavailable"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/readbackEvidence"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "status": {
              "enum": [
                "confirmed",
                "pending"
              ]
            },
            "attempts": {
              "const": 1
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "attempts": {
              "const": 0
            },
            "evidence": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "attempts": {
              "const": 1
            },
            "evidence": {
              "minItems": 1,
              "maxItems": 1
            }
          }
        }
      ]
    },
    "observedLease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseId",
        "leaseRef",
        "leaseDigest"
      ],
      "properties": {
        "leaseId": {
          "$ref": "#/$defs/leaseId"
        },
        "leaseRef": {
          "$ref": "#/$defs/leaseRef"
        },
        "leaseDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/hostFactToken"
        },
        "message": {
          "$ref": "#/$defs/trimmedText"
        }
      }
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "strictUtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "description": "Explicit UTC RFC 3339 timestamp; runtime validation also rejects impossible calendar dates and enforces lineage/lease ordering."
    }
  }
}
