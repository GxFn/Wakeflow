{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:maintenance:workspace-mutation-lock:v1",
  "title": "Wakeflow Internal Workspace Mutation Lock",
  "$comment": "Ephemeral ownership record for the one workspace mutation gate. Runtime validation additionally enforces canonical bytes, 0600 mode, single-link regular-file identity, exact owner release, process-identity probing, lock/journal tuple equality, and recovery-claim reference equality. acquiredAt is diagnostic only and is never reclaim authority.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "operationId",
    "mode",
    "operationKind",
    "domainOwner",
    "ownerToken",
    "recoveryGeneration",
    "processIdentity",
    "recoveryClaim",
    "acquiredAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "wakeflow-workspace-mutation-lock" },
    "operationId": { "$ref": "#/$defs/operationId" },
    "mode": {
      "type": "string",
      "enum": ["runtime-mutation", "maintenance", "recovery-cleanup"]
    },
    "operationKind": { "$ref": "#/$defs/boundedToken" },
    "domainOwner": { "$ref": "#/$defs/boundedToken" },
    "ownerToken": { "$ref": "#/$defs/ownerToken" },
    "recoveryGeneration": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "processIdentity": { "$ref": "#/$defs/processIdentity" },
    "recoveryClaim": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/recoveryClaimRef" }
      ]
    },
    "acquiredAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "recoveryGeneration": { "const": 0 } },
        "required": ["recoveryGeneration"]
      },
      "then": {
        "properties": {
          "mode": { "enum": ["runtime-mutation", "maintenance"] },
          "recoveryClaim": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "mode": { "const": "recovery-cleanup" },
          "recoveryClaim": { "$ref": "#/$defs/recoveryClaimRef" }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^workspace-mutation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ownerToken": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recoveryClaimRef": {
      "type": "object",
      "required": ["ref", "generation", "digest"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^\\.wakeflow-local/runtime/maintenance/transactions/workspace-mutation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.recovery-[1-9][0-9]*\\.json$"
        },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "boundedToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "processIdentity": {
      "type": "object",
      "required": [
        "platform",
        "pid",
        "startIdentity"
      ],
      "properties": {
        "platform": { "type": "string", "enum": ["darwin", "linux"] },
        "pid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "startIdentity": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
