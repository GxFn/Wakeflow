{
  "kind": "ClaudeSubwindowDispatchConfig",
  "version": 1,
  "windowName": "WakeflowFixture",
  "repositoryPath": ".",
  "responsibility": "Wakeflow runtime controller",
  "dispatchable": true,
  "threadRegistered": false,
  "threadRegistryFile": "hosts/claude-code/thread-registry/WakeflowFixture.json",
  "cwd": "@wakeflow-fixture-root/WakeflowFixture",
  "responsibilityRoot": "@wakeflow-fixture-root/WakeflowFixture",
