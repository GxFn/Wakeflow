{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wakeflow/wakeflow-state.schema.json",
  "title": "Controller State",
  "type": "object",
  "required": [
    "schemaVersion",
    "demandKey",
    "title",
    "state",
    "stateReason",
    "revision",
    "activeStageId",
    "updatedAt",
    "allowedActions",
    "blockers",
    "decisionsRequired",
    "stages",
    "taskPackages",
    "targetTasks",
    "windows",
    "review",
    "automation",
    "projection"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "demandKey": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "demandAuthorityRef": {
      "type": "string",
      "const": "demand-authority.json"
    },
    "demandAuthorityDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "demandType": {
      "type": "string",
      "enum": ["requirement", "bug", "supplement", "research"]
    },
    "executionPlacement": {
      "type": "object",
      "required": ["mode", "podId"],
      "properties": {
        "mode": { "type": "string", "enum": ["main", "isolated"] },
        "podId": { "type": ["string", "null"] },
        "selection": {
          "type": "string",
          "enum": ["mainline-default", "explicit-user-pod"]
        },
        "authorizationRef": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "podProvisioning": {
      "type": "object",
      "required": ["phase", "podId", "authorizationRef"],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "reserved",
            "creating-control",
            "control-ready",
            "designing",
            "creating-products",
            "execution-ready",
            "retryable",
            "blocked",
            "cancelling",
            "closing",
            "closed"
          ]
        },
        "podId": { "type": "string", "minLength": 1 },
        "host": {
          "type": "string",
          "enum": ["codex", "claude-code"]
        },
        "authorizationRef": { "type": "string", "minLength": 1 },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["windowName", "role", "launchCorrelationId", "status"],
            "properties": {
              "windowName": { "type": "string", "minLength": 1 },
              "role": {
                "type": "string",
                "enum": ["controller", "design", "test", "product"]
              },
              "repositoryWindow": { "type": "string", "minLength": 1 },
              "launchCorrelationId": { "type": "string", "minLength": 1 },
              "status": {
                "type": "string",
                "enum": ["planned", "bound", "closed"]
              }
            },
            "additionalProperties": false
          }
        },
        "designRequestId": { "type": "string", "minLength": 1 },
        "designRequestRef": { "type": "string", "minLength": 1 },
        "designHandoffRef": { "type": "string", "minLength": 1 },
        "testAccess": {
          "type": "object",
          "required": [
            "probeId",
            "status",
            "capability",
            "bindingSetDigest",
            "planDigest",
            "productBindingCount",
            "updatedAt"
          ],
          "properties": {
            "probeId": { "type": "string", "minLength": 1 },
            "status": {
              "type": "string",
              "enum": ["pending", "validated", "blocked"]
            },
            "capability": {
              "type": "string",
              "enum": [
                "pending",
                "direct-multi-root",
                "unsupported",
                "per-repo-executor-unavailable"
              ]
            },
            "bindingSetDigest": { "type": "string", "minLength": 1 },
            "planDigest": { "type": "string", "minLength": 1 },
            "productBindingCount": { "type": "integer", "minimum": 1 },
            "receiptDigest": { "type": "string", "minLength": 1 },
            "reasonCode": {
              "type": "string",
              "enum": [
                "direct-multi-root-unsupported",
                "access-probe-failed",
                "per-repo-executor-unavailable"
              ]
            },
            "validatedAt": { "type": "string", "minLength": 1 },
            "updatedAt": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "updatedAt": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "string",
      "description": "Demand workflow state. review-ready means target review inputs are structurally available for controller inspection; it does not mean truth was verified or work was accepted.",
      "enum": [
        "intake",
        "planned",
        "dispatched",
        "waiting-results",
        "review-ready",
        "needs-rework",
        "blocked",
        "cancelled",
        "completed",
        "archived"
      ]
    },
    "stateReason": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "activeStageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "string"
    },
    "allowedActions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisionsRequired": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "taskPackages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "targetTasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "windows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "status",
        "readyResultIds",
        "blockedResultIds",
        "missingResultIds"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "readyResultIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockedResultIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingResultIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "automation": {
      "type": "object",
      "required": [
        "enabled",
        "activeRunIds",
        "lastReviewPack"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "activeRunIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastReviewPack": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "projection": {
      "type": "object",
      "required": [
        "status",
        "lastRenderedAt",
        "progressDoc"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "lastRenderedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "progressDoc": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "dependentRequired": {
    "demandAuthorityRef": ["demandAuthorityDigest"],
    "demandAuthorityDigest": ["demandAuthorityRef"]
  },
  "additionalProperties": false
}
