{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/wakeflow/target-result.schema.json",
  "title": "Target Result",
  "type": "object",
  "required": ["schemaVersion", "resultId", "targetWindow", "targetTaskId", "status", "evidenceRefs"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "resultId": { "type": "string", "minLength": 1 },
    "demandKey": { "type": "string", "minLength": 1 },
    "taskPackageId": { "type": "string", "minLength": 1 },
    "dispatchGroup": { "type": "string", "minLength": 1 },
    "targetWindow": { "type": "string", "minLength": 1 },
    "targetTaskId": { "type": "string", "minLength": 1 },
    "currentResult": { "type": "boolean" },
    "resultRevision": { "type": "integer", "minimum": 1 },
    "historyReason": { "type": "string", "enum": ["late-dispatch-group"] },
    "supersedes": {
      "type": "object",
      "properties": {
        "resultId": { "type": "string", "minLength": 1 },
        "dispatchGroup": { "type": "string", "minLength": 1 },
        "historyFile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "status": { "type": "string", "enum": ["completed", "blocked", "needs-review"] },
    "summary": { "type": "string" },
    "changedRepos": { "type": "array", "items": { "type": "string" } },
    "commits": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target-authored commit locators for controller inspection; presence does not establish correctness."
    },
    "commitDisposition": { "type": "string", "enum": ["committed", "left-uncommitted", "no-changes"] },
    "evidenceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target-authored artifact locators. Wakeflow may check path existence; it does not verify artifact truth."
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Target-authored validation summaries supplied as controller review inputs, not independent verification."
    },
    "risks": { "type": "array", "items": { "type": "string" } },
    "wakeflowTrace": { "type": "object" },
    "createdAt": { "type": "string" },
    "stateRevisionObserved": { "type": "integer", "minimum": 1 },
    "forbiddenConclusions": { "type": "array", "items": { "type": "string" } },
    "craftEvidence": {
      "type": "array",
      "description": "Target-authored typed review inputs. Required kinds, mappings, and path locatability may be checked mechanically; truth and acceptance remain controller judgments.",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 1 },
          "verify": { "type": "string", "minLength": 1 },
          "anchorId": { "type": "string", "minLength": 1 },
          "red": { "type": "string", "minLength": 1 },
          "green": { "type": "string", "minLength": 1 },
          "planIndex": { "type": "integer", "minimum": 0 },
          "step": { "type": "string", "minLength": 1 }
        },
        "anyOf": [
          { "required": ["ref"] },
          { "required": ["value"] },
          { "required": ["commit"] }
        ],
        "additionalProperties": true
      }
    },
    "resultMapping": {
      "type": "object",
      "description": "Structural coverage of controller-authored acceptance anchors or approved Test steps. Complete means mapped, not verified or accepted.",
      "required": ["contract", "compatibility", "status"],
      "properties": {
        "contract": { "type": "string", "enum": ["target-result-envelope-v1", "target-result-envelope-v2"] },
        "compatibility": { "type": "string", "enum": ["legacy", "enforced"] },
        "status": { "type": "string", "enum": ["legacy-unenforced", "partial", "complete", "invalid"] },
        "acceptanceAnchorIds": { "type": "array", "items": { "type": "string" } },
        "testPlanIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
