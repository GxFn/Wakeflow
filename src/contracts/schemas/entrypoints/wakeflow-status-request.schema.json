{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:entrypoints:status-request:v1",
  "x-wakeflow-runtime-export": "WAKEFLOW_STATUS_REQUEST_SCHEMA",
  "title": "WakeflowStatusRequestV1",
  "description": "wakeflow_status 的只读请求：工作区定向投影；带 demandId 时附该 Demand 的当前 Controller Route，已归档的 Demand 返回归档回执。",
  "type": "object",
  "additionalProperties": false,
  "required": ["root"],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Absolute path of the existing Wakeflow workspace root."
    },
    "demandId": {
      "$ref": "#/$defs/demandId"
    }
  },
  "$defs": {
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
