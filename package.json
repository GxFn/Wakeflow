{
  "name": "wakeflow-repo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "description": "Development workspace for the Wakeflow Codex and Claude Code plugin artifacts.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --pretty false",
    "check:architecture": "tsc -b tooling/tsconfig.json --pretty false && node .build/tooling/architecture/check-dependencies.js",
    "build:artifacts": "tsc -b tooling/tsconfig.json src/entrypoints/tsconfig.json --pretty false && node .build/tooling/artifacts/build-plugin-artifacts.js",
    "build:artifacts:committed": "tsc -b tooling/tsconfig.json src/entrypoints/tsconfig.json --pretty false && node .build/tooling/artifacts/build-plugin-artifacts.js --committed",
    "build:check": "tsc -b tooling/tsconfig.json src/entrypoints/tsconfig.json --pretty false && node .build/tooling/artifacts/check-plugin-artifacts.js",
    "smoke:artifacts": "tsc -b tooling/tsconfig.json --pretty false && node .build/tooling/artifacts/smoke-plugin-artifacts.js",
    "test:tooling": "node --test .build/tests/codegen/schema-types.test.js",
    "test:typescript": "tsc -b tooling/tsconfig.json tests/tsconfig.json --pretty false && node .build/tooling/testing/run-typescript-tests.js",
    "test:typescript:focused": "tsc -b tooling/tsconfig.json tests/tsconfig.json --pretty false && node .build/tooling/testing/run-typescript-tests.js --focused",
    "schema:build": "tsc -b tooling/tsconfig.json --pretty false && node .build/tooling/codegen/schema-types.js build --repo-root .",
    "schema:check": "tsc -b tooling/tsconfig.json --pretty false && node .build/tooling/codegen/schema-types.js check --repo-root .",
    "check:typescript": "npm run typecheck && npm run check:architecture && npm run lint && npm run format:check && npm run check:unused && npm run test:typescript && npm run schema:check && npm run build:check",
    "release:check": "tsc -b tooling/tsconfig.json --pretty false && node .build/tooling/release/check-release-consistency.js --require-main --require-clean --require-tag --require-remote",
    "test": "npm run check:typescript",
    "scenario:acceptance": "npm run test:typescript:focused -- tests/scenarios/wakeflow-scenario-acceptance.test.ts",
    "lint": "biome lint src tests tooling",
    "lint:fix": "biome lint --write src tests tooling",
    "format": "biome format --write src tests tooling",
    "format:check": "biome format src tests tooling",
    "check:unused": "knip --no-progress --no-gitignore"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@modelcontextprotocol/client": "2.0.0",
    "@swc/core": "1.16.1",
    "@types/node": "24.13.3",
    "dependency-cruiser": "18.2.0",
    "es-module-lexer": "2.3.2",
    "json-schema-to-typescript": "15.0.4",
    "knip": "6.34.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "canonicalize": "4.0.0",
    "jsonc-parser": "3.3.1",
    "p-limit": "7.3.1"
  }
}
