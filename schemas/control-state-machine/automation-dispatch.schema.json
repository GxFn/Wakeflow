    "stateRoot",
    "stateRevision",
    "taskPackageId",
    "targetTaskId",
    "dispatchGroup",
    "controllerWindow",
    "returnPolicy",
    "threadRegistryRef",
    "deliveryStatus"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "stateRoot": { "type": "string", "minLength": 1 },
    "stateRevision": { "type": "integer", "minimum": 1 },
    "taskPackageId": { "type": "string", "minLength": 1 },
    "targetTaskId": { "type": "string", "minLength": 1 },
    "dispatchGroup": { "type": "string", "minLength": 1 },
    "controllerWindow": { "type": "string", "minLength": 1 },
    "returnPolicy": { "type": "object" },
    "threadRegistryRef": { "type": ["string", "null"] },
    "deliveryStatus": { "type": "string" },
    "humanContextRef": { "type": ["string", "null"] }
  },
  "additionalProperties": true
