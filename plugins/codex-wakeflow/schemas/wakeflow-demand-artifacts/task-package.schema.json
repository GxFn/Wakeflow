{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:demand-artifacts:task-package:v1",
  "title": "Wakeflow Candidate Task Package",
  "$comment": "Structural and lexical contract for one immutable candidate task package. Runtime validation additionally enforces same-demand identity, topology assignment, canonical reference equality, digest equality, ordered sets, exact referenced artifacts, and create-only storage.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "demandId",
    "demandRef",
    "demandDigest",
    "demandAuthorityRef",
    "demandAuthorityDigest",
    "createdAt",
    "taskPackageId",
    "targetTaskId",
    "windowId",
    "workType",
    "objective",
    "confirmedContext",
    "requirementRefs",
    "boundaries",
    "completionExpectations",
    "dependsOnTargetTaskIds",
    "acceptanceAnchors",
    "reviewInputContract"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "artifactKind": { "type": "string", "const": "wakeflow-task-package" },
    "programId": { "$ref": "#/$defs/programId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "demandRef": { "type": "string", "const": "demand.json" },
    "demandDigest": { "$ref": "#/$defs/digest" },
    "demandAuthorityRef": { "type": "string", "const": "demand-authority.json" },
    "demandAuthorityDigest": { "$ref": "#/$defs/digest" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "taskPackageId": { "$ref": "#/$defs/taskPackageId" },
    "targetTaskId": { "$ref": "#/$defs/targetTaskId" },
    "windowId": { "$ref": "#/$defs/windowId" },
    "repositoryId": { "$ref": "#/$defs/repositoryId" },
    "workType": {
      "type": "string",
      "enum": ["implementation", "research", "documentation", "test"]
    },
    "objective": { "$ref": "#/$defs/trimmedText" },
    "confirmedContext": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "requirementRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementRef" },
      "contains": {
        "properties": { "role": { "const": "goal" } },
        "required": ["role"]
      },
      "minContains": 1
    },
    "boundaries": { "$ref": "#/$defs/boundaries" },
    "completionExpectations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/trimmedText" }
    },
    "dependsOnTargetTaskIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/targetTaskId" }
    },
    "commitExpectation": {
      "type": "string",
      "enum": ["commit", "leave-uncommitted"]
    },
    "designIntent": { "$ref": "#/$defs/trimmedText" },
    "acceptanceAnchors": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/acceptanceAnchor" }
    },
    "reviewInputContract": { "$ref": "#/$defs/reviewInputContract" },
    "testCard": { "$ref": "#/$defs/testCardTuple" },
    "continuation": { "$ref": "#/$defs/continuation" },
    "replacesTargetTask": { "$ref": "#/$defs/replacesTargetTask" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "workType": { "const": "implementation" } },
        "required": ["workType"]
      },
      "then": {
        "properties": {
          "acceptanceAnchors": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "workType": { "const": "test" } },
        "required": ["workType"]
      },
      "then": {
        "required": ["testCard"],
        "not": {
          "anyOf": [
            { "required": ["repositoryId"] },
            { "required": ["commitExpectation"] }
          ]
        },
        "properties": {
          "acceptanceAnchors": { "maxItems": 0 },
          "reviewInputContract": {
            "properties": {
              "requiredAcceptanceAnchorIds": { "maxItems": 0 }
            }
          }
        }
      },
      "else": {
        "required": ["repositoryId", "commitExpectation"],
        "not": { "required": ["testCard"] }
      }
    },
    {
      "not": { "required": ["continuation", "replacesTargetTask"] }
    }
  ],
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "taskPackageId": {
      "type": "string",
      "pattern": "^task-package_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "targetTaskId": {
      "type": "string",
      "pattern": "^target-task_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "testCardId": {
      "type": "string",
      "pattern": "^test-card_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "opaqueToken": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "portableRef": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!\\s)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\/$)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "testCardRef": {
      "type": "string",
      "pattern": "^test-cards/test-card_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "taskPackageRef": {
      "type": "string",
      "pattern": "^task-packages/task-package_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "requirementRef": {
      "type": "object",
      "required": ["role", "ref", "digest"],
      "properties": {
        "role": {
          "type": "string",
          "enum": ["goal", "completion", "constraint", "validation", "design", "evidence"]
        },
        "ref": { "$ref": "#/$defs/portableRef" },
        "digest": { "$ref": "#/$defs/digest" },
        "anchor": { "$ref": "#/$defs/opaqueToken" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "evidence" } },
            "required": ["role"]
          },
          "else": { "required": ["anchor"] }
        }
      ]
    },
    "boundaries": {
      "type": "object",
      "required": ["inScope", "outOfScope", "forbidden"],
      "properties": {
        "inScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trimmedText" }
        },
        "outOfScope": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trimmedText" }
        },
        "forbidden": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/trimmedText" }
        }
      },
      "additionalProperties": false
    },
    "acceptanceAnchor": {
      "type": "object",
      "required": ["anchorId", "claim", "probe", "expected"],
      "properties": {
        "anchorId": { "$ref": "#/$defs/opaqueToken" },
        "claim": { "$ref": "#/$defs/trimmedText" },
        "probe": { "$ref": "#/$defs/trimmedText" },
        "expected": { "$ref": "#/$defs/trimmedText" }
      },
      "additionalProperties": false
    },
    "reviewInputContract": {
      "type": "object",
      "required": ["requiredKinds", "requiredAcceptanceAnchorIds"],
      "properties": {
        "requiredKinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueToken" }
        },
        "requiredAcceptanceAnchorIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueToken" }
        }
      },
      "additionalProperties": false
    },
    "testCardTuple": {
      "type": "object",
      "required": ["testCardId", "ref", "digest"],
      "properties": {
        "testCardId": { "$ref": "#/$defs/testCardId" },
        "ref": { "$ref": "#/$defs/testCardRef" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "continuation": {
      "type": "object",
      "required": ["kind", "previousTaskPackageId", "ref", "digest", "reason"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["optimization", "requirement-supplement", "verified-bug"]
        },
        "previousTaskPackageId": { "$ref": "#/$defs/taskPackageId" },
        "ref": { "$ref": "#/$defs/taskPackageRef" },
        "digest": { "$ref": "#/$defs/digest" },
        "reason": { "$ref": "#/$defs/trimmedText" }
      },
      "additionalProperties": false
    },
    "replacesTargetTask": {
      "type": "object",
      "required": ["targetTaskId", "taskPackageRef", "taskPackageDigest"],
      "properties": {
        "targetTaskId": { "$ref": "#/$defs/targetTaskId" },
        "taskPackageRef": { "$ref": "#/$defs/taskPackageRef" },
        "taskPackageDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
