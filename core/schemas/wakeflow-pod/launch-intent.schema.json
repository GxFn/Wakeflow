{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:pod:launch-intent:v1",
  "title": "Wakeflow Pod Launch Intent",
  "$comment": "Create-once host-neutral business intent. Runtime validation forbids semantic titles, absolute paths, prompts, argv, raw handles, mutable status, and adapter extensions.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "podId",
    "demandId",
    "windowId",
    "launchOperationId",
    "bindingId",
    "role",
    "environmentIntent",
    "createdAt"
  ],
  "properties": {
    "kind": { "type": "string", "const": "WakeflowPodLaunchIntent" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "podId": { "$ref": "#/$defs/podId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "windowId": { "$ref": "#/$defs/windowId" },
    "launchOperationId": { "$ref": "#/$defs/launchOperationId" },
    "bindingId": { "$ref": "#/$defs/bindingId" },
    "role": { "type": "string", "enum": ["controller", "design", "test", "product"] },
    "repositoryId": { "$ref": "#/$defs/repositoryId" },
    "responsibilityWindowId": { "$ref": "#/$defs/windowId" },
    "repositorySourceDigest": { "$ref": "#/$defs/digest" },
    "environmentIntent": { "type": "string", "enum": ["host-local", "host-worktree"] },
    "basePolicy": { "type": "string", "const": "local-head" },
    "expectedBaseHead": { "$ref": "#/$defs/gitObject" },
    "hostResourceKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "createdAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "product" } }, "required": ["role"] },
      "then": {
        "required": ["repositoryId", "repositorySourceDigest", "basePolicy", "expectedBaseHead"],
        "properties": { "environmentIntent": { "const": "host-worktree" } }
      },
      "else": {
        "properties": { "environmentIntent": { "const": "host-local" } },
        "not": { "anyOf": [
          { "required": ["repositoryId"] },
          { "required": ["responsibilityWindowId"] },
          { "required": ["repositorySourceDigest"] },
          { "required": ["basePolicy"] },
          { "required": ["expectedBaseHead"] }
        ] }
      }
    }
  ],
  "$defs": {
    "programId": { "type": "string", "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hostId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "podId": { "type": "string", "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "demandId": { "type": "string", "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "windowId": { "type": "string", "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "repositoryId": { "type": "string", "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "launchOperationId": { "type": "string", "pattern": "^pod-launch_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "bindingId": { "type": "string", "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$" }
  }
}
