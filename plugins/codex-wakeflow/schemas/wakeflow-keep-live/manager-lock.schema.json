{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:keep-live:manager-lock:v1",
  "title": "Wakeflow Keep-Live Manager Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "hostId",
    "lockId",
    "workspaceOperationId",
    "owner",
    "acquiredAt",
    "lockDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "wakeflow-keep-live-manager-lock" },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "lockId": { "$ref": "#/$defs/requestId" },
    "workspaceOperationId": {
      "type": "string",
      "pattern": "^workspace-mutation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "owner": { "$ref": "#/$defs/processIdentity" },
    "acquiredAt": { "$ref": "#/$defs/timestamp" },
    "lockDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hostId": {
      "type": "string",
      "enum": ["codex", "claude-code"]
    },
    "requestId": {
      "type": "string",
      "pattern": "^keep-live-request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "pid", "startIdentity"],
      "properties": {
        "platform": { "enum": ["darwin", "linux"] },
        "pid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "startIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
