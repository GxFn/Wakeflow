{
  "$schema": "https://raw.githubusercontent.com/GxFn/Wakeflow/main/core/schemas/wakeflow-config.schema.json",
  "kind": "WakeflowConfig",
  "schemaVersion": 3,
  "program": {
    "programId": "program_11111111-1111-4111-8111-111111111111",
    "displayName": "Example Program",
    "description": "Controller-visible explanation only.",
    "interfaceLanguage": "en"
  },
  "topology": {
    "repositories": [
      {
        "repositoryId": "repository_22222222-2222-4222-8222-222222222222",
        "path": "../ProductA",
        "displayName": "Product A",
        "description": "Product source responsibility root.",
        "instructionManagement": "managed-block",
        "validation": {
          "residueExceptions": [
            {
              "path": ".cursor/skills",
              "reason": "The repository owner keeps this integration."
            }
          ]
        }
      }
    ],
    "supportSurfaces": [
      {
        "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
        "capability": "design",
        "path": "../ProductDesign",
        "displayName": "Design",
        "description": "External requirement design surface.",
        "ownership": "external-owned",
        "instructionManagement": "managed-block"
      },
      {
        "surfaceId": "surface_44444444-4444-4444-8444-444444444444",
        "capability": "test",
        "path": "../ProductTest",
        "displayName": "Test",
        "description": "External independent test surface.",
        "ownership": "external-owned",
        "instructionManagement": "owner-managed"
      }
    ],
    "windows": [
      {
        "windowId": "window_55555555-5555-4555-8555-555555555555",
        "role": "controller",
        "displayName": "Controller",
        "description": "Wakeflow control window.",
        "root": {
          "kind": "program"
        }
      },
      {
        "windowId": "window_66666666-6666-4666-8666-666666666666",
        "role": "design",
        "displayName": "Design",
        "root": {
          "kind": "support-surface",
          "surfaceId": "surface_33333333-3333-4333-8333-333333333333"
        }
      },
      {
        "windowId": "window_77777777-7777-4777-8777-777777777777",
        "role": "test",
        "displayName": "Test",
        "root": {
          "kind": "support-surface",
          "surfaceId": "surface_44444444-4444-4444-8444-444444444444"
        }
      },
      {
        "windowId": "window_88888888-8888-4888-8888-888888888888",
        "role": "product",
        "displayName": "Product A Backend",
        "description": "Backend responsibility.",
        "root": {
          "kind": "repository",
          "repositoryId": "repository_22222222-2222-4222-8222-222222222222"
        }
      },
      {
        "windowId": "window_99999999-9999-4999-8999-999999999999",
        "role": "product",
        "displayName": "Product A Frontend",
        "description": "Frontend responsibility in the same repository.",
        "root": {
          "kind": "repository",
          "repositoryId": "repository_22222222-2222-4222-8222-222222222222"
        }
      }
    ]
  },
  "storage": {
    "ledgerRoot": "../wakeflow-ledger"
  },
  "governance": {
    "audit": {
      "preservedReviewAfterDays": 30
    },
    "validation": {
      "runtimeResidue": {
        "label": "product runtime",
        "matchers": [
          {
            "kind": "substring",
            "value": "product-dev-server"
          },
          {
            "kind": "regex",
            "value": "node\\s+server\\.mjs"
          }
        ]
      }
    }
  },
  "hosts": {
    "codex": {
      "launch": {
        "modelByRole": {
          "product": "gpt-5.6-codex"
        },
        "reasoningEffortByRole": {
          "controller": "max",
          "product": "xhigh"
        }
      }
    },
    "claude-code": {
      "launch": {
        "modelByRole": {
          "default": "claude-opus"
        },
        "reasoningEffortByRole": {
          "controller": "max"
        },
        "permissionMode": "acceptEdits"
      },
      "tmux": {
        "sessionName": "wakeflow",
        "socketName": "wakeflow-example"
      }
    }
  }
}
