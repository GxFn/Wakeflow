              }
            }
          },
          "else": {
            "properties": {
              "taskPackage": {
                "allOf": [
                  {
                    "$ref": "#/$defs/reviewTaskPackage"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "workType": {
                        "const": "test"
                      }
                    }
                  }
                ]
              },
              "targetResult": {
                "allOf": [
                  {
                    "$ref": "#/$defs/targetResult"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "workType": {
                        "const": "test"
                      }
                    }
                  }
                ]
              }
            }
