{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GxFn/Wakeflow/main/core/schemas/wakeflow-config.schema.json",
  "x-wakeflow-runtime-export": "WAKEFLOW_CONFIG_V3_SCHEMA",
  "title": "Wakeflow Config v3",
  "description": "Strict public schema for Wakeflow durable program intent. Runtime facts, host handles, fixed protocol roots, derived paths, and migration history are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "kind",
    "schemaVersion",
    "program",
    "presentation",
    "topology",
    "storage",
    "governance",
    "hosts"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/GxFn/Wakeflow/main/core/schemas/wakeflow-config.schema.json",
      "description": "Canonical public schema URL for the tracked durable configuration.",
      "examples": [
        "https://raw.githubusercontent.com/GxFn/Wakeflow/main/core/schemas/wakeflow-config.schema.json"
      ]
    },
    "kind": {
      "const": "WakeflowConfig",
      "description": "Discriminator for a Wakeflow durable configuration.",
      "examples": [
        "WakeflowConfig"
      ]
    },
    "schemaVersion": {
      "const": 3,
      "description": "Durable configuration schema version.",
      "examples": [
        3
      ]
    },
    "program": {
      "$ref": "#/$defs/program"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "topology": {
      "$ref": "#/$defs/topology"
    },
    "storage": {
      "$ref": "#/$defs/storage"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "hosts": {
      "$ref": "#/$defs/hosts"
    }
  },
  "$defs": {
    "trimmedNonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[\\s\\S]*\\S$",
      "description": "A non-empty string whose first and last characters are not whitespace; this mirrors the strict loader's trim check.",
      "examples": [
        "Example Program"
      ]
    },
    "nonEmptyString": {
      "allOf": [
        {
          "$ref": "#/$defs/trimmedNonEmptyString"
        }
      ],
      "description": "Compatibility alias for the shared trimmed non-empty string constraint used by durable text fields.",
      "examples": [
        "Controller-visible explanation"
      ]
    },
    "portableRelativePlacement": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/trimmedNonEmptyString"
        }
      ],
      "pattern": "^(?![A-Za-z]:)(?:\\.\\./)*(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+)*$",
      "description": "Canonical portable relative placement. A leading ../ chain may address a named sibling root; absolute paths, drive-relative paths, backslashes, empty or dot-only paths, empty segments, and embedded dot traversal are rejected.",
      "examples": [
        "Design",
        "../ProductA",
        "../wakeflow-ledger"
      ]
    },
    "repositoryChildPath": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/trimmedNonEmptyString"
        }
      ],
      "pattern": "^(?![A-Za-z]:)(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000\\r\\n]+)*$",
      "description": "Canonical portable path that remains below its owning repository; parent traversal and all other non-canonical placement forms are rejected.",
      "examples": [
        ".cursor/skills",
        "generated/reports"
      ]
    },
    "regexPattern": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/trimmedNonEmptyString"
        }
      ],
      "format": "regex",
      "description": "A trimmed ECMAScript regular-expression source validated with Unicode semantics before runtime use.",
      "examples": [
        "node\\s+server\\.mjs"
      ]
    },
    "claudeTmuxSessionName": {
      "type": "string",
      "allOf": [
        {
          "$ref": "#/$defs/trimmedNonEmptyString"
        }
      ],
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$",
      "description": "Desired Claude tmux session name, bounded to 128 control-free characters before any host effect.",
      "examples": [
        "wakeflow"
      ]
    },
    "claudeTmuxSocketName": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)[A-Za-z0-9._-]{1,128}$",
      "description": "Safe tmux -L socket name shared with the Claude locator contract; slash, whitespace, controls, and dot-only aliases are rejected.",
      "examples": [
        "wakeflow-example"
      ]
    },
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable program identity: the program_ prefix followed by a lowercase RFC 4122 variant UUID v4.",
      "examples": [
        "program_11111111-1111-4111-8111-111111111111"
      ]
    },
    "repositoryId": {
      "type": "string",
      "pattern": "^repository_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable product-repository identity: the repository_ prefix followed by a lowercase UUID v4.",
      "examples": [
        "repository_22222222-2222-4222-8222-222222222222"
      ]
    },
    "surfaceId": {
      "type": "string",
      "pattern": "^surface_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable Design or Test support-surface identity: the surface_ prefix followed by a lowercase UUID v4.",
      "examples": [
        "surface_33333333-3333-4333-8333-333333333333"
      ]
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Stable logical-window identity: the window_ prefix followed by a lowercase UUID v4.",
      "examples": [
        "window_55555555-5555-4555-8555-555555555555"
      ]
    },
    "program": {
      "description": "Tracked durable program identity and display metadata; it contains no presentation policy, paths, runtime state, or host handles.",
      "examples": [
        {
          "programId": "program_11111111-1111-4111-8111-111111111111",
          "displayName": "Example Program"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "programId",
        "displayName"
      ],
      "properties": {
        "programId": {
          "$ref": "#/$defs/programId",
          "description": "Stable program identity generated once; never derived from display text or paths."
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing program title; it is not identity or a foreign key."
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional human explanation; it does not affect identity or state."
        }
      }
    },
    "presentation": {
      "description": "Tracked durable policy for Wakeflow-generated human-facing text. It is shared by the program and is not an inferred host or machine-local preference.",
      "examples": [
        {
          "language": "en"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language"
      ],
      "properties": {
        "language": {
          "enum": [
            "en",
            "zh-Hans"
          ],
          "default": "en",
          "description": "BCP 47 language tag for Wakeflow-generated human-facing text. Fresh initialization explicitly persists en when no language is selected; readers never infer a value from the host environment.",
          "examples": [
            "en",
            "zh-Hans"
          ]
        }
      }
    },
    "topology": {
      "description": "Durable product repositories, Design/Test support surfaces, and stable logical windows connected only through typed references.",
      "examples": [
        {
          "repositories": [
            {
              "repositoryId": "repository_22222222-2222-4222-8222-222222222222",
              "path": "../ProductA",
              "displayName": "Product A",
              "instructionManagement": "owner-managed"
            }
          ],
          "supportSurfaces": [
            {
              "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
              "capability": "design",
              "path": "Design",
              "displayName": "Design",
              "ownership": "wakeflow-managed"
            },
            {
              "surfaceId": "surface_44444444-4444-4444-8444-444444444444",
              "capability": "test",
              "path": "Test",
              "displayName": "Test",
              "ownership": "wakeflow-managed"
            }
          ],
          "windows": [
            {
              "windowId": "window_55555555-5555-4555-8555-555555555555",
              "role": "controller",
              "displayName": "Controller",
              "root": {
                "kind": "program"
              }
            },
            {
              "windowId": "window_66666666-6666-4666-8666-666666666666",
              "role": "design",
              "displayName": "Design",
              "root": {
                "kind": "support-surface",
                "surfaceId": "surface_33333333-3333-4333-8333-333333333333"
              }
            },
            {
              "windowId": "window_77777777-7777-4777-8777-777777777777",
              "role": "test",
              "displayName": "Test",
              "root": {
                "kind": "support-surface",
                "surfaceId": "surface_44444444-4444-4444-8444-444444444444"
              }
            },
            {
              "windowId": "window_88888888-8888-4888-8888-888888888888",
              "role": "product",
              "displayName": "Product A",
              "root": {
                "kind": "repository",
                "repositoryId": "repository_22222222-2222-4222-8222-222222222222"
              }
            }
          ]
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "supportSurfaces",
        "windows"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "description": "At least one durable product-repository entity; array order is presentation order, not identity.",
          "examples": [
            [
              {
                "repositoryId": "repository_22222222-2222-4222-8222-222222222222",
                "path": "../ProductA",
                "displayName": "Product A",
                "instructionManagement": "owner-managed"
              }
            ]
          ],
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "supportSurfaces": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "description": "Exactly one Design surface and one Test surface. The strict loader also requires each singleton role window to reference its matching capability.",
          "examples": [
            [
              {
                "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
                "capability": "design",
                "path": "Design",
                "displayName": "Design",
                "ownership": "wakeflow-managed"
              },
              {
                "surfaceId": "surface_44444444-4444-4444-8444-444444444444",
                "capability": "test",
                "path": "Test",
                "displayName": "Test",
                "ownership": "wakeflow-managed"
              }
            ]
          ],
          "items": {
            "$ref": "#/$defs/supportSurface"
          },
          "allOf": [
            {
              "description": "Exactly one durable Design support surface is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "capability": {
                    "const": "design"
                  }
                },
                "required": [
                  "capability"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "Exactly one durable Test support surface is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "capability": {
                    "const": "test"
                  }
                },
                "required": [
                  "capability"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "windows": {
          "type": "array",
          "minItems": 4,
          "description": "Stable logical windows with exactly one controller, one Design, one Test, and at least one product window; dynamic Pod windows are excluded.",
          "examples": [
            [
              {
                "windowId": "window_55555555-5555-4555-8555-555555555555",
                "role": "controller",
                "displayName": "Controller",
                "root": {
                  "kind": "program"
                }
              },
              {
                "windowId": "window_66666666-6666-4666-8666-666666666666",
                "role": "design",
                "displayName": "Design",
                "root": {
                  "kind": "support-surface",
                  "surfaceId": "surface_33333333-3333-4333-8333-333333333333"
                }
              },
              {
                "windowId": "window_77777777-7777-4777-8777-777777777777",
                "role": "test",
                "displayName": "Test",
                "root": {
                  "kind": "support-surface",
                  "surfaceId": "surface_44444444-4444-4444-8444-444444444444"
                }
              },
              {
                "windowId": "window_88888888-8888-4888-8888-888888888888",
                "role": "product",
                "displayName": "Product A",
                "root": {
                  "kind": "repository",
                  "repositoryId": "repository_22222222-2222-4222-8222-222222222222"
                }
              }
            ]
          ],
          "items": {
            "$ref": "#/$defs/window"
          },
          "allOf": [
            {
              "description": "Exactly one durable controller window is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "controller"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "Exactly one durable Design window is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "design"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "Exactly one durable Test window is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "test"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "description": "At least one durable product window is required.",
              "contains": {
                "type": "object",
                "properties": {
                  "role": {
                    "const": "product"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "minContains": 1
            }
          ]
        }
      }
    },
    "repository": {
      "description": "A stable product-source responsibility root; path and display text may change without changing repositoryId.",
      "examples": [
        {
          "repositoryId": "repository_22222222-2222-4222-8222-222222222222",
          "path": "../ProductA",
          "displayName": "Product A",
          "instructionManagement": "owner-managed"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "path",
        "displayName",
        "instructionManagement"
      ],
      "properties": {
        "repositoryId": {
          "$ref": "#/$defs/repositoryId"
        },
        "path": {
          "$ref": "#/$defs/portableRelativePlacement",
          "description": "Canonical relative placement from the program root."
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing repository title; never an identity key.",
          "examples": [
            "Product A"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional human explanation of the repository responsibility.",
          "examples": [
            "Product source responsibility root."
          ]
        },
        "instructionManagement": {
          "enum": [
            "owner-managed",
            "managed-block"
          ],
          "description": "owner-managed leaves instructions entirely to the repository owner; managed-block permits only Wakeflow's bounded managed block.",
          "examples": [
            "owner-managed"
          ]
        },
        "validation": {
          "$ref": "#/$defs/repositoryValidation",
          "description": "Repository-scoped validation exceptions with explicit owner reasons.",
          "examples": [
            {
              "residueExceptions": []
            }
          ]
        }
      }
    },
    "repositoryValidation": {
      "description": "Strict repository-specific validation policy; it cannot weaken workspace protocol boundaries.",
      "examples": [
        {
          "residueExceptions": [
            {
              "path": ".cursor/skills",
              "reason": "The repository owner keeps this integration."
            }
          ]
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "residueExceptions"
      ],
      "properties": {
        "residueExceptions": {
          "type": "array",
          "description": "Exact repository-child paths allowed as intentional residue; duplicate paths are rejected by the shared loader.",
          "examples": [
            [
              {
                "path": ".cursor/skills",
                "reason": "The repository owner keeps this integration."
              }
            ]
          ],
          "items": {
            "$ref": "#/$defs/residueException"
          }
        }
      }
    },
    "residueException": {
      "description": "One exact repository-child residue exception and its non-empty owner justification.",
      "examples": [
        {
          "path": ".cursor/skills",
          "reason": "The repository owner keeps this integration."
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryChildPath",
          "description": "Canonical repository-relative child path."
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-readable repository-owner justification; it grants only the exact path above.",
          "examples": [
            "The repository owner keeps this integration."
          ]
        }
      }
    },
    "supportSurface": {
      "description": "A discriminated Design or Test support surface with either whole-surface Wakeflow ownership or explicit external ownership.",
      "examples": [
        {
          "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
          "capability": "design",
          "path": "Design",
          "displayName": "Design",
          "ownership": "wakeflow-managed"
        }
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/wakeflowManagedSurface"
        },
        {
          "$ref": "#/$defs/externalOwnedSurface"
        }
      ]
    },
    "wakeflowManagedSurface": {
      "description": "A built-in Design/Test surface whose generated memory and scaffold are wholly owned by Wakeflow; instructionManagement is forbidden.",
      "examples": [
        {
          "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
          "capability": "design",
          "path": "Design",
          "displayName": "Design",
          "ownership": "wakeflow-managed"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "capability",
        "path",
        "displayName",
        "ownership"
      ],
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/surfaceId"
        },
        "capability": {
          "enum": [
            "design",
            "test"
          ],
          "description": "Protocol capability provided by this support surface: requirements design or independent testing.",
          "examples": [
            "design"
          ]
        },
        "path": {
          "$ref": "#/$defs/portableRelativePlacement"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing support-surface title; never an identity key.",
          "examples": [
            "Design"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional human explanation of the support-surface responsibility.",
          "examples": [
            "Requirement and outcome design surface."
          ]
        },
        "ownership": {
          "const": "wakeflow-managed",
          "description": "Wakeflow owns the entire generated support surface and memory file.",
          "examples": [
            "wakeflow-managed"
          ]
        }
      }
    },
    "externalOwnedSurface": {
      "description": "An externally owned Design/Test surface; Wakeflow creates no scaffold and manages instructions only under the explicit policy.",
      "examples": [
        {
          "surfaceId": "surface_33333333-3333-4333-8333-333333333333",
          "capability": "design",
          "path": "../ProductDesign",
          "displayName": "Design",
          "ownership": "external-owned",
          "instructionManagement": "managed-block"
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceId",
        "capability",
        "path",
        "displayName",
        "ownership",
        "instructionManagement"
      ],
      "properties": {
        "surfaceId": {
          "$ref": "#/$defs/surfaceId"
        },
        "capability": {
          "enum": [
            "design",
            "test"
          ],
          "description": "Protocol capability supplied by the external surface: requirements design or independent testing.",
          "examples": [
            "design"
          ]
        },
        "path": {
          "$ref": "#/$defs/portableRelativePlacement"
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing external support-surface title; never an identity key.",
          "examples": [
            "Design"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional human explanation of the external support responsibility.",
          "examples": [
            "External requirement design surface."
          ]
        },
        "ownership": {
          "const": "external-owned",
          "description": "The external owner controls the surface; Wakeflow must not create its normal scaffold.",
          "examples": [
            "external-owned"
          ]
        },
        "instructionManagement": {
          "enum": [
            "owner-managed",
            "managed-block"
          ],
          "description": "owner-managed forbids Wakeflow instruction writes; managed-block permits only the bounded Wakeflow block.",
          "examples": [
            "managed-block"
          ]
        }
      }
    },
    "window": {
      "description": "A discriminated stable logical window. Its role determines the exact typed root reference shape.",
      "examples": [
        {
          "windowId": "window_55555555-5555-4555-8555-555555555555",
          "role": "controller",
          "displayName": "Controller",
          "root": {
            "kind": "program"
          }
        }
      ],
      "oneOf": [
        {
          "$ref": "#/$defs/controllerWindow"
        },
        {
          "$ref": "#/$defs/designWindow"
        },
        {
          "$ref": "#/$defs/testWindow"
        },
        {
          "$ref": "#/$defs/productWindow"
        }
      ]
    },
    "controllerWindow": {
      "description": "The single durable Controller window rooted at the program boundary.",
      "examples": [
        {
          "windowId": "window_55555555-5555-4555-8555-555555555555",
          "role": "controller",
          "displayName": "Controller",
          "root": {
            "kind": "program"
          }
        }
      ],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windowId",
        "role",
        "displayName",
        "root"
      ],
      "properties": {
        "windowId": {
          "$ref": "#/$defs/windowId"
        },
        "role": {
          "const": "controller",
          "description": "Protocol role for the unique Controller window.",
          "examples": [
            "controller"
          ]
        },
        "displayName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Human-facing Controller title; never an identity key.",
          "examples": [
            "Controller"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Optional human explanation of the Controller responsibility.",
          "examples": [
            "Wakeflow control window."
          ]
        },
        "root": {
          "$ref": "#/$defs/programRoot"
        }
      }
    },
    "designWindow": {
