{
  "name": "wakeflow-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for the Wakeflow Codex plugin.",
  "type": "module",
  "workspaces": [
    "plugins/wakeflow"
  ],
  "scripts": {
    "validate": "npm --workspace wakeflow run validate",
    "smoke": "npm --workspace wakeflow run smoke",
    "mcp": "npm --workspace wakeflow run mcp",
    "test:wakeflow": "node --test test/*.test.mjs",
    "test": "npm run validate && npm run smoke && npm run test:wakeflow"
  },
  "engines": {
    "node": ">=20"
  }
}
