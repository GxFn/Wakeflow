{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:claude-activity-monitor-process:v1",
  "title": "Wakeflow Claude Activity Monitor Process",
  "description": "Strict Claude-only current process generation for one opaque tmux server context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "serverContextId",
    "serverContextDigest",
    "monitorId",
    "processIdentity",
    "executableDigest",
    "argvDigest",
    "startedAt",
    "processDigest"
  ],
  "properties": {
    "kind": { "const": "WakeflowClaudeActivityMonitorProcess" },
    "schemaVersion": { "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "const": "claude-code" },
    "serverContextId": { "$ref": "#/$defs/serverContextId" },
    "serverContextDigest": { "$ref": "#/$defs/digest" },
    "monitorId": {
      "type": "string",
      "pattern": "^claude-monitor_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "processIdentity": { "$ref": "#/$defs/processIdentity" },
    "executableDigest": { "$ref": "#/$defs/digest" },
    "argvDigest": { "$ref": "#/$defs/digest" },
    "startedAt": { "$ref": "#/$defs/timestamp" },
    "processDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "serverContextId": {
      "type": "string",
      "pattern": "^claude-server-context_[0-9a-f]{64}$"
    },
    "processIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "pid", "startIdentity"],
      "properties": {
        "platform": { "enum": ["darwin", "linux"] },
        "pid": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "startIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
