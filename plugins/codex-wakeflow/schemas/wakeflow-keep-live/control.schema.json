{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:keep-live:control:v1",
  "title": "Wakeflow Keep-Live Control Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "hostId",
    "generationId",
    "requestId",
    "action",
    "phase",
    "revision",
    "requestedAt",
    "updatedAt",
    "errorCode",
    "controlDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactKind": { "const": "wakeflow-keep-live-control" },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "generationId": { "$ref": "#/$defs/generationId" },
    "requestId": { "$ref": "#/$defs/requestId" },
    "action": { "enum": ["start", "stop"] },
    "phase": { "enum": ["requested", "acknowledged", "failed"] },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "requestedAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "errorCode": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/code" }
      ]
    },
    "controlDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "hostId": {
      "type": "string",
      "enum": ["codex", "claude-code"]
    },
    "generationId": {
      "type": "string",
      "pattern": "^keep-live-generation_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^keep-live-request_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
