#!/bin/sh

# Wakeflow MCP 的固定制品启动器。
# 它只定位同一物理制品内的 MCP server、选择 Node.js 20+ 并保持原始
# stdin/stdout；不解析 MCP 消息、不选择 workspace，也不接受后端替换参数。

set -eu

# 启动器错误保持稳定且不输出制品绝对路径，避免把本机安装位置写入宿主日志。
mcp_error() {
  code=$1
  message=$2
  printf '%s: %s\n' "$code" "$message" >&2
}

if [ "$#" -ne 0 ]; then
  mcp_error "wakeflow-mcp-invalid-argv" "Wakeflow MCP accepts zero arguments; communicate with the server over stdin/stdout."
  exit 64
fi

# 从 launcher 目录固定派生唯一 server，并拒绝用 symbolic link 替换最终后端。
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PLUGIN_ROOT=$(dirname -- "$SCRIPT_DIR")
SERVER="$PLUGIN_ROOT/mcp/server.cjs"

if [ -L "$SERVER" ]; then
  mcp_error "wakeflow-mcp-server-invalid" "Wakeflow MCP server must be one exact regular artifact file."
  exit 127
fi

if [ ! -f "$SERVER" ]; then
  mcp_error "wakeflow-mcp-server-missing" "Wakeflow MCP server is missing from the exact artifact."
  exit 127
fi

node_major() {
  "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null
}

run_node_if_usable() {
  candidate=$1
  [ -n "$candidate" ] || return 1
  [ -x "$candidate" ] || return 1
  major=$(node_major "$candidate") || return 1
  case "$major" in
    ''|*[!0-9]*) return 1 ;;
  esac
  [ "$major" -ge 20 ] || return 1
  exec "$candidate" "$SERVER"
}

if [ -n "${WAKEFLOW_NODE:-}" ]; then
  if ! run_node_if_usable "$WAKEFLOW_NODE"; then
    mcp_error "wakeflow-mcp-node-invalid" "WAKEFLOW_NODE must identify an executable Node.js 20+ runtime."
    exit 127
  fi
fi

path_node=$(command -v node 2>/dev/null || true)
if run_node_if_usable "$path_node"; then
  exit 0
fi

# Codex Desktop exposes a pnpm wrapper on PATH. Its bundled Node runtime lives
# at a stable path relative to that wrapper even when the Node directory itself
# is not exported on the app-server PATH.
pnpm_path=$(command -v pnpm 2>/dev/null || true)
if [ -n "$pnpm_path" ]; then
  pnpm_dir=$(CDPATH= cd -- "$(dirname -- "$pnpm_path")" && pwd)
  if run_node_if_usable "$pnpm_dir/../../node/bin/node"; then
    exit 0
  fi
fi

if [ -n "${HOME:-}" ]; then
  for candidate in \
    "$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" \
    "$HOME/.volta/bin/node" \
    "$HOME/.local/share/mise/shims/node" \
    "$HOME/.asdf/shims/node" \
    "$HOME"/.nvm/versions/node/*/bin/node
  do
    if run_node_if_usable "$candidate"; then
      exit 0
    fi
  done
fi

for candidate in \
  "/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node" \
  "/opt/homebrew/bin/node" \
  "/usr/local/bin/node"
do
  if run_node_if_usable "$candidate"; then
    exit 0
  fi
done

mcp_error "wakeflow-mcp-node-missing" "Wakeflow MCP requires Node.js 20+."
exit 127
