{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:delivery:delivery-envelope:v1",
  "title": "Wakeflow Delivery Envelope",
  "$comment": "Closed structural contract for immutable one-shot direct-thread intent. Runtime validation additionally enforces canonical derived refs, group correlation, complete self-excluding digest equality, target group/packet membership and prompt equality, or controller-window equality. Host handles, current binding or lease state, mutable demand state, send/readback outcomes, and result bodies are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactKind",
    "programId",
    "demandId",
    "deliveryId",
    "groupId",
    "groupRef",
    "groupDigest",
    "preparedByHostId",
    "windowId",
    "identityRef",
    "bindingId",
    "identityBindingDigest",
    "prompt",
    "oneShot",
    "transportPolicy",
    "readbackPolicy",
    "automationRequested",
    "correlationId",
    "createdAt",
    "envelopeDigest"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "artifactKind": {
      "type": "string",
      "enum": [
        "wakeflow-controller-return-envelope",
        "wakeflow-target-delivery-envelope"
      ]
    },
    "programId": {
      "$ref": "#/$defs/programId"
    },
    "demandId": {
      "$ref": "#/$defs/demandId"
    },
    "deliveryId": {
      "$ref": "#/$defs/deliveryId"
    },
    "groupId": {
      "$ref": "#/$defs/groupId"
    },
    "groupRef": {
      "$ref": "#/$defs/groupRef"
    },
    "groupDigest": {
      "$ref": "#/$defs/digest"
    },
    "packetId": {
      "$ref": "#/$defs/packetId"
    },
    "packetRef": {
      "$ref": "#/$defs/packetRef"
    },
    "packetDigest": {
      "$ref": "#/$defs/digest"
    },
    "resultSetDigest": {
      "$ref": "#/$defs/digest"
    },
    "reviewSnapshotDigest": {
      "$ref": "#/$defs/digest"
    },
    "preparedByHostId": {
      "type": "string",
      "enum": [
        "codex",
        "claude-code"
      ]
    },
    "windowId": {
      "$ref": "#/$defs/windowId"
    },
    "identityRef": {
      "$ref": "#/$defs/identityRef"
    },
    "bindingId": {
      "$ref": "#/$defs/bindingId"
    },
    "identityBindingDigest": {
      "$ref": "#/$defs/digest"
    },
    "prompt": {
      "$ref": "#/$defs/trimmedText"
    },
    "oneShot": {
      "type": "boolean",
      "const": true
    },
    "transportPolicy": {
      "$ref": "#/$defs/transportPolicy"
    },
    "readbackPolicy": {
      "$ref": "#/$defs/readbackPolicy"
    },
    "automationRequested": {
      "type": "boolean"
    },
    "correlationId": {
      "$ref": "#/$defs/groupId"
    },
    "createdAt": {
      "$ref": "#/$defs/strictUtcTimestamp"
    },
    "envelopeDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "oneOf": [
    {
      "required": [
        "packetId",
        "packetRef",
        "packetDigest"
      ],
      "properties": {
        "artifactKind": {
          "const": "wakeflow-target-delivery-envelope"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "resultSetDigest"
            ]
          },
          {
            "required": [
              "reviewSnapshotDigest"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "resultSetDigest",
        "reviewSnapshotDigest"
      ],
      "properties": {
        "artifactKind": {
          "const": "wakeflow-controller-return-envelope"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "packetId"
            ]
          },
          {
            "required": [
              "packetRef"
            ]
          },
          {
            "required": [
              "packetDigest"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "programId": {
      "type": "string",
      "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "demandId": {
      "type": "string",
      "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "deliveryId": {
      "type": "string",
      "pattern": "^delivery_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "groupId": {
      "type": "string",
      "pattern": "^dispatch-group_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "packetId": {
      "type": "string",
      "pattern": "^dispatch-packet_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "windowId": {
      "type": "string",
      "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "groupRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/shared/transport/demands/demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/groups/dispatch-group_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "packetRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/shared/transport/demands/demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/packets/dispatch-packet_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "identityRef": {
      "type": "string",
      "pattern": "^\\.wakeflow-local/runtime/hosts/(?:codex|claude-code)/identity/window-bindings/window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}\\.json$"
    },
    "trimmedText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?:[\\r\\n]|[^\\u0000-\\u001F\\u007F-\\u009F])*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$"
    },
    "strictUtcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$",
      "description": "Explicit UTC RFC 3339 timestamp; runtime validation also rejects impossible calendar dates."
    },
    "transportPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "missingIdentity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "direct-thread"
        },
        "missingIdentity": {
          "type": "string",
          "const": "rejected-before-send"
        }
      }
    },
    "readbackPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "maxObservations"
      ],
      "properties": {
        "required": {
          "type": "boolean",
          "const": true
        },
        "maxObservations": {
          "type": "integer",
          "const": 1
        }
      }
    }
  }
}
