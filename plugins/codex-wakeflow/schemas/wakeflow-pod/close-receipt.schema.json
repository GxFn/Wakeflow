{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wakeflow:internal:pod:close-receipt:v1",
  "title": "Wakeflow Pod Close Receipt",
  "$comment": "Create-once close proof admitted from either an exact machine-verified host result or a never-materialized member with no current identity. Core records it before logical resource release or identity/locator cleanup.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "programId",
    "hostId",
    "podId",
    "demandId",
    "windowId",
    "closeOperationId",
    "bindingId",
    "closeIntentDigest",
    "verificationStatus",
    "sessionStatus",
    "worktreeStatus",
    "confirmedAt",
    "recordedAt"
  ],
  "properties": {
    "kind": { "type": "string", "const": "WakeflowPodCloseReceipt" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "programId": { "$ref": "#/$defs/programId" },
    "hostId": { "$ref": "#/$defs/hostId" },
    "podId": { "$ref": "#/$defs/podId" },
    "demandId": { "$ref": "#/$defs/demandId" },
    "windowId": { "$ref": "#/$defs/windowId" },
    "closeOperationId": { "$ref": "#/$defs/closeOperationId" },
    "bindingId": { "$ref": "#/$defs/bindingId" },
    "closeIntentDigest": { "$ref": "#/$defs/digest" },
    "verificationStatus": { "type": "string", "enum": ["machine-verified", "unmaterialized-not-found"] },
    "hostResultDigest": { "$ref": "#/$defs/digest" },
    "sessionStatus": { "type": "string", "enum": ["closed", "not-found"] },
    "worktreeStatus": { "type": "string", "enum": ["not-applicable", "removed", "retained", "unknown"] },
    "confirmedAt": { "$ref": "#/$defs/timestamp" },
    "recordedAt": { "$ref": "#/$defs/timestamp" }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "required": ["hostResultDigest"],
      "properties": {
        "hostId": { "const": "claude-code" },
        "verificationStatus": { "const": "machine-verified" },
        "sessionStatus": { "const": "closed" }
      }
    },
    {
      "not": { "required": ["hostResultDigest"] },
      "properties": {
        "verificationStatus": { "const": "unmaterialized-not-found" },
        "sessionStatus": { "const": "not-found" },
        "worktreeStatus": { "const": "not-applicable" }
      }
    }
  ],
  "$defs": {
    "programId": { "type": "string", "pattern": "^program_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "hostId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "podId": { "type": "string", "pattern": "^pod_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "demandId": { "type": "string", "pattern": "^demand_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "windowId": { "type": "string", "pattern": "^window_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "closeOperationId": { "type": "string", "pattern": "^pod-close_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "bindingId": { "type": "string", "pattern": "^binding_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,9})?Z$" }
  }
}
