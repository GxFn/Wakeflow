    "scripts/",
    "skills/",
    "templates/",
    "wakeflow.config.example.json",
    "wakeflow.config.json"
  ],
  "scripts": {
    "validate": "node scripts/wakeflow-validate.mjs",
    "smoke": "node scripts/wakeflow-smoke.mjs",
    "mcp": "node ./mcp/server.cjs",
    "test": "npm run validate && npm run smoke"
  },
  "engines": {
    "node": ">=20"
  }
}
